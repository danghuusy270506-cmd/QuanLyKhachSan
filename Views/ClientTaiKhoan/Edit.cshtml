
@model QuanLyKhachSan.Models.ViewModels.ClientCapNhatThongTinViewModel

@{
    ViewData["Title"] = "Chỉnh sửa thông tin cá nhân";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

<div class="container py-5" style="max-width: 760px;">

    <div class="mb-4">
        <a asp-controller="ClientTaiKhoan"
           asp-action="Index"
           class="text-decoration-none">
            &larr; Quay lại tài khoản
        </a>

        <h2 class="fw-bold mt-3">
            Chỉnh sửa thông tin cá nhân
        </h2>

        <p class="text-muted">
            Cập nhật thông tin để thuận tiện cho việc đặt phòng và liên hệ.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">

            <form asp-controller="ClientTaiKhoan"
                  asp-action="Edit"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="HoTen"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="HoTen"
                           class="form-control"
                           placeholder="Nhập họ và tên" />

                    <span asp-validation-for="HoTen"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Sdt"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Sdt"
                           type="tel"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />

                    <span asp-validation-for="Sdt"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Nhập địa chỉ email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Cccd"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Cccd"
                           class="form-control"
                           placeholder="Nhập số CCCD" />

                    <span asp-validation-for="Cccd"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit"
                            class="btn btn-primary px-4">
                        Lưu thay đổi
                    </button>

                    <a asp-controller="ClientTaiKhoan"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>
