
@model QuanLyKhachSan.Models.ViewModels.ClientDatPhongViewModel

@{
    ViewData["Title"] = "Đặt phòng";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var loaiPhong = ViewBag.LoaiPhong;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="mb-4">
                <a asp-controller="ClientLoaiPhong"
                   asp-action="Index"
                   class="text-decoration-none">
                    &larr; Quay lại danh sách loại phòng
                </a>

                <h2 class="mt-3 fw-bold">Đặt phòng khách sạn</h2>
                <p class="text-muted">
                    Vui lòng kiểm tra thông tin phòng và nhập thời gian lưu trú.
                </p>
            </div>

            @if (loaiPhong != null)
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-3">
                            @loaiPhong.TenLoaiPhong
                        </h4>

                        <div class="mb-2">
                            <span class="text-muted">Giá phòng:</span>
                            <strong class="text-primary">
                                @Convert.ToDecimal(
                                    loaiPhong.GiaPhong).ToString("N0") đ
                            </strong>
                            <span class="text-muted">/ đêm</span>
                        </div>

                        <div>
                            <span class="text-muted">Sức chứa:</span>
                            <strong>
                                @loaiPhong.SucChua người
                            </strong>
                        </div>
                    </div>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">
                        Thông tin đặt phòng
                    </h5>

                    <form asp-controller="ClientDatPhong"
                          asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <input asp-for="MaLoaiPhong" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="NgayDen"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="NgayDen"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="NgayDen"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NgayDi"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="NgayDi"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="NgayDi"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SoNguoi"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="SoNguoi"
                                   type="number"
                                   min="1"
                                   max="20"
                                   class="form-control" />

                            <span asp-validation-for="SoNguoi"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Tiếp tục đặt phòng
                            </button>

                            <a asp-controller="ClientLoaiPhong"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
