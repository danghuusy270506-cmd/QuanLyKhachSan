@model QuanLyKhachSan.Models.Entities.KhachHang

@{
    ViewData["Title"] = "Xóa khách hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-trash-fill text-danger"></i> Xóa khách hàng
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="alert alert-warning d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa khách hàng này?
                    Hành động này không thể hoàn tác.
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <i class="bi bi-person-x"></i> Thông tin khách hàng sắp xóa
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Mã khách hàng</dt>
                        <dd class="col-sm-8">@Model.MaKhachHang</dd>

                        <dt class="col-sm-4">Họ tên</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.HoTen</dd>

                        <dt class="col-sm-4">CCCD</dt>
                        <dd class="col-sm-8">@Model.Cccd</dd>

                        <dt class="col-sm-4">SĐT</dt>
                        <dd class="col-sm-8">@Model.Sdt</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Username</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">
                                @Model.TaiKhoan?.Username
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" method="post"
                  asp-route-maKhachHang="@Model.MaKhachHang" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Xác nhận xóa
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Hủy
                </a>
            </form>
        </div>
    </div>
</div>