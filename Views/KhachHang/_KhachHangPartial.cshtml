@model IEnumerable<QuanLyKhachSan.Models.Entities.KhachHang>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã KH</th>
                        <th>Họ Tên Khách Hàng</th>
                        <th>Số Điện Thoại</th>
                        <th>CCCD / CMND</th>
                        <th>Email</th>
                        <th>Tài Khoản</th>
                        <th class="text-center" style="width: 280px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">#@item.MaKhachHang</td>
                                <td class="fw-semibold">@item.HoTen</td>
                                <td>
                                    <span class="badge-loai-phong">
                                        @(string.IsNullOrEmpty(item.Sdt) ? "Chưa có" : item.Sdt)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-loai-phong">
                                        @(string.IsNullOrEmpty(item.Cccd) ? "Chưa có" : item.Cccd)
                                    </span>
                                </td>
                                <td class="fw-bold text-danger">
                                    @(string.IsNullOrEmpty(item.Email) ? "---" : item.Email)
                                </td>
                                <td>
                                    @if (item.TaiKhoan != null)
                                    {
                                        <span class="custom-badge-status status-active">
                                            @item.TaiKhoan.Username
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="custom-badge-status status-locked">
                                            Chưa liên kết
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <!-- Đã bọc div d-inline-flex gap-1 để các nút nằm ngang và có khoảng cách -->
                                    <div class="d-inline-flex gap-1">
                                        <a href="javascript:void(0);" class="btn-action btn-action-view btn-view-details" data-id="@item.MaKhachHang" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                        <a href="javascript:void(0);" class="btn-action btn-action-edit btn-open-edit-modal" data-id="@item.MaKhachHang" title="Sửa">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        <a href="javascript:void(0);" class="btn-action btn-action-delete btn-open-delete-modal" data-id="@item.MaKhachHang" title="Xóa">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy khách hàng phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Phân trang căn giữa -->
@if (totalPages > 1)
{
    <div class="d-flex justify-content-center mt-4">
        <nav>
            <ul class="pagination custom-pagination mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link ajax-page-link" href="#" data-page="@(currentPage - 1)">Trước</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link ajax-page-link" href="#" data-page="@i">@i</a>
                        </li>
                    }
                    else if (i == currentPage - 3 || i == currentPage + 3)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link ajax-page-link" href="#" data-page="@(currentPage + 1)">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
}