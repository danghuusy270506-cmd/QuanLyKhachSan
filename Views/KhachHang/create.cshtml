@model QuanLyKhachSan.Models.Entities.KhachHang

@{
    ViewData["Title"] = "Thêm mới thông tin Khách hàng";
}

<div class="container-fluid px-4 mt-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>NHẬP THÔNG TIN KHÁCH HÀNG (TẠI QUẦY / ĐIỆN THOẠI)</h5>
            <a asp-action="Index" class="btn btn-sm btn-light fw-bold text-primary">Danh sách khách hàng</a>
        </div>
        <div class="card-body p-4">

            <!-- Hiển thị thông báo lỗi chung -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <form asp-controller="KhachHang" asp-action="Create" method="post">

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Họ và Tên Khách hàng <span class="text-danger">*</span></label>
                        <input asp-for="HoTen" class="form-control" required placeholder="Ví dụ: Nguyễn Văn A" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                        <input asp-for="Sdt" class="form-control" placeholder="Nhập số điện thoại khách hàng..." />
                        <span asp-validation-for="Sdt" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Số CCCD / CMND</label>
                        <input asp-for="Cccd" class="form-control" placeholder="Nhập số CCCD (nếu có)..." />
                        <span asp-validation-for="Cccd" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Địa chỉ Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email khách hàng (nếu có)..." />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="alert alert-info py-2 small mt-2">
                    <i class="bi bi-info-circle me-1"></i> Hệ thống sẽ tự động tạo Tài khoản Web cho khách hàng với <b>Mật khẩu mặc định: 123456</b> (Tên đăng nhập là SĐT hoặc Email).
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="PhieuDatPhong" asp-action="Index" class="btn btn-secondary fw-bold">Hủy bỏ</a>
                    <button type="submit" class="btn btn-success fw-bold px-4">
                        <i class="bi bi-check-circle me-1"></i> Lưu & Chuyển Sang Đặt Phòng
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}