@model QuanLyKhachSan.Models.Entities.KhachHang

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Thông tin chi tiết khách hàng</h4>
            <span class="badge bg-light text-dark">ID: #@Model.MaKhachHang</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <strong>Họ và tên:</strong>
                    <p class="text-muted">@Model.HoTen</p>
                </div>
                <div class="col-md-6">
                    <strong>Tên tài khoản:</strong>
                    <p class="text-muted">@Model.Username</p>
                </div>
                <div class="col-md-6">
                    <strong>Số CCCD/CMND:</strong>
                    <p class="text-muted">@Model.Cccd</p>
                </div>
                <div class="col-md-6">
                    <strong>Số điện thoại:</strong>
                    <p class="text-muted">@Model.Sdt</p>
                </div>
                <div class="col-md-12">
                    <strong>Địa chỉ Email:</strong>
                    <p class="text-muted">@Model.Email</p>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <a asp-controller="KhachHang" asp-action="Edit" asp-route-maKhachHang="@Model.MaKhachHang" class="btn btn-warning">
                Sửa thông tin
            </a>
            <a asp-controller="KhachHang" asp-action="Index" class="btn btn-secondary">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>