@model QuanLyKhachSan.Models.Entities.KhachHang

<div class="alert alert-warning d-flex align-items-center mb-3">
    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
    <div>
        <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa khách hàng này?
        Hành động này không thể hoàn tác.
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header bg-danger text-white">
        <i class="bi bi-person-x"></i> Thông tin khách hàng sắp xóa
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Mã khách hàng</dt>
            <dd class="col-sm-8">@Model.MaKhachHang</dd>

            <dt class="col-sm-4">Họ tên</dt>
            <dd class="col-sm-8 fw-semibold">@Model.HoTen</dd>

            <dt class="col-sm-4">CCCD</dt>
            <dd class="col-sm-8">@(Model.Cccd ?? "Chưa có")</dd>

            <dt class="col-sm-4">SĐT</dt>
            <dd class="col-sm-8">@(Model.Sdt ?? "Chưa có")</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@(Model.Email ?? "---")</dd>
        </dl>
    </div>
</div>

<form id="formDeleteKhachHang" asp-action="Delete" method="post" asp-route-maKhachHang="@Model.MaKhachHang">
    @Html.AntiForgeryToken()
</form>