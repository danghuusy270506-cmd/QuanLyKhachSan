@model IEnumerable<QuanLyKhachSan.Models.Entities.KhachHang>

@{
    ViewData["Title"] = "Danh sách khách hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh Sách Khách Hàng</h2>
        <!-- Nút thêm khách hàng mới -->
        <a asp-controller="KhachHang" asp-action="Create" class="btn btn-success">
            + Thêm khách hàng mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            Chưa có dữ liệu khách hàng nào trong hệ thống!
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã KH</th>
                        <th>Họ và tên</th>
                        <th>Tài khoản</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>CCCD / CMND</th>
                        <th class="text-center" style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var khachHang in Model)
                    {
                        <tr>
                            <td><strong>#@khachHang.MaKhachHang</strong></td>
                            <td>@khachHang.HoTen</td>
                            <td><span class="badge bg-secondary">@khachHang.Username</span></td>
                            <td>@khachHang.Sdt</td>
                            <td>@khachHang.Email</td>
                            <td>@khachHang.Cccd</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <!-- Xem chi tiết -->
                                    <a asp-controller="KhachHang"
                                       asp-action="Details"
                                       asp-route-maKhachHang="@khachHang.MaKhachHang"
                                       class="btn btn-outline-info"
                                       title="Xem chi tiết">
                                        Chi tiết
                                    </a>

                                    <!-- Sửa thông tin -->
                                    <a asp-controller="KhachHang"
                                       asp-action="Edit"
                                       asp-route-maKhachHang="@khachHang.MaKhachHang"
                                       class="btn btn-outline-warning"
                                       title="Chỉnh sửa">
                                        Sửa
                                    </a>
                                    

                                    <!-- Xóa (dùng Form POST bảo mật) -->
                                    <form asp-controller="KhachHang"
                                          asp-action="Delete"
                                          asp-route-maKhachHang="@khachHang.MaKhachHang"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa khách hàng này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>