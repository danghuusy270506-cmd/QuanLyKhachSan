@model IEnumerable<QuanLyKhachSan.Models.Entities.KhachHang>

@{
    ViewData["Title"] = "Danh sách khách hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-people-fill text-primary"></i> Danh sách khách hàng
        </h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm khách hàng
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>#</th>
                            <th>Họ tên</th>
                            <th>CCCD</th>
                            <th>SĐT</th>
                            <th>Email</th>
                            <th>Tài khoản</th>
                            <th>Trạng thái</th>
                            <th class="text-center" style="width: 220px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3"></i><br />
                                    Chưa có khách hàng nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var kh in Model)
                            {
                                <tr>
                                    <td>@kh.MaKhachHang</td>
                                    <td class="fw-semibold">@kh.HoTen</td>
                                    <td>@kh.Cccd</td>
                                    <td>@kh.Sdt</td>
                                    <td>@kh.Email</td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-person-badge"></i> @kh.TaiKhoan?.Username
                                        </span>
                                    </td>
                                    <td>
                                        @if (kh.TaiKhoan?.TrangThai == "HoatDong")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i> @kh.TaiKhoan?.TrangThai
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-maKhachHang="@kh.MaKhachHang"
                                           class="btn btn-sm btn-outline-info" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-maKhachHang="@kh.MaKhachHang"
                                           class="btn btn-sm btn-outline-warning" title="Sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-maKhachHang="@kh.MaKhachHang"
                                           class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>