@model IEnumerable<QuanLyKhachSan.Models.Entities.DichVu>

@{
    ViewData["Title"] = "Quản lý dịch vụ";
    var tuKhoa = ViewData["TuKhoa"]?.ToString();
    var hasTuKhoa = !string.IsNullOrWhiteSpace(tuKhoa);
}

<link rel="stylesheet" href="~/css/DichVu/Index.css" asp-append-version="true" />

<div class="container-fluid py-3 service-page">
    <!-- Tiêu đề & Nút Thêm Mới -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">Quản lý khách sạn</div>
            <h1 class="h3 fw-bold text-dark mb-0">Danh sách dịch vụ</h1>
        </div>
        <button type="button" class="btn btn-dark btn-create-modal px-3 py-2 rounded-2 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm Dịch Vụ Mới
        </button>
    </div>

    <!-- Thông báo -->
    @if (TempData["ThongBaoThanhCong"] is string thongBao)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@thongBao
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ThongBaoLoi"] is string thongBaoLoi)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@thongBaoLoi
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Khu vực Lọc dữ liệu -->
    @await Html.PartialAsync("_FilterPartial", new QuanLyKhachSan.Models.ViewModels.FilterViewModel
    {
        ActionUrl = Url.Action("Index", "DichVu"),
        Placeholder = "Nhập tên, mã hoặc mô tả dịch vụ...",
        SearchParamName = "tuKhoa",
        SearchValue = ViewData["TuKhoa"]?.ToString()
    })

    <!-- Khung chứa bảng dữ liệu -->
    <div id="tableContainer" class="card shadow-sm border-0 rounded-3 overflow-hidden">
        @await Html.PartialAsync("_DichVuPartial", Model)
    </div>
</div>

<!-- Modal Chi tiết Dịch Vụ -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="bi bi-receipt text-info"></i>
                    Chi tiết dịch vụ: <span class="text-info fw-bold" id="modalTitleServiceCode"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-0" id="detailModalBody">
                <!-- Nội dung AJAX -->
            </div>
            <div class="modal-footer border-0 bg-light py-3 px-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Sửa Dịch Vụ -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-warning"></i>
                    Sửa dịch vụ: <span class="text-warning fw-bold" id="modalTitleEditCode"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4" id="editModalBody">
                <!-- Nội dung AJAX -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Xóa Dịch Vụ -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="bi bi-trash3 text-danger"></i>
                    Xác nhận xóa dịch vụ: <span class="text-danger fw-bold" id="modalTitleDeleteCode"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4" id="deleteModalBody">
                <!-- Nội dung AJAX -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Dịch Vụ -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
            <div class="modal-header text-white" style="background-color: #1e293b;">
                <h5 class="modal-title fw-bold" id="createModalLabel">
                    <i class="bi bi-plus-circle me-2"></i> Thêm dịch vụ mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="createModalBody">
                <!-- Nội dung AJAX -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/DichVu/Index.js" asp-append-version="true"></script>
}