@model IEnumerable<QuanLyKhachSan.Models.Entities.DichVu>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenDichVu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MoTa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChiTietXepPhong_DichVus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TenDichVu)
            </td>
            <td>
                @Html.DisplayFor(model => item.MoTa)
            </td>
            <td>
                @Html.DisplayFor(model => item.ChiTietXepPhong_DichVus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaDichVu">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaDichVu">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaDichVu">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
