@model IEnumerable<QuanLyKhachSan.Models.Entities.DichVu>

@{
    ViewData["Title"] = "Quản lý dịch vụ";
}

<div class="container-fluid py-3 service-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-uppercase small fw-semibold text-primary mb-1">Quản lý khách sạn</div>
            <h1 class="h3 fw-bold mb-1">Danh sách dịch vụ</h1>
            <div class="text-muted">Quản lý tên dịch vụ, mô tả và đơn giá áp dụng.</div>
        </div>
        <a asp-action="Create" class="btn btn-primary px-3">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Thêm dịch vụ
        </a>
    </div>

    @if (TempData["ThongBaoThanhCong"] is string thongBao)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @thongBao
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ThongBaoLoi"] is string thongBaoLoi)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @thongBaoLoi
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="card border-0 shadow-sm service-card">
        <div class="card-body p-3 p-lg-4">
            <form asp-action="Index" method="get" class="row g-2 align-items-center mb-3">
                <div class="col-12 col-md-6 col-lg-4">
                    <label for="tuKhoa" class="visually-hidden">Tìm dịch vụ</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <input id="tuKhoa" name="tuKhoa" value="@(ViewData["TuKhoa"] ?? "")" class="form-control" placeholder="Tìm theo tên, mã hoặc mô tả..." />
                    </div>
                </div>
                <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">Tìm kiếm</button></div>
                @if (ViewData["TuKhoa"] is string tuKhoa && !string.IsNullOrWhiteSpace(tuKhoa))
                {
                    <div class="col-auto"><a asp-action="Index" class="btn btn-link text-decoration-none">Xóa lọc</a></div>
                }
                <div class="col ms-md-auto text-md-end small text-muted">Tổng: @Model.Count() dịch vụ</div>
            </form>

            <div class="table-responsive">
                <table class="table align-middle table-hover service-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="text-nowrap">Mã dịch vụ</th>
                            <th scope="col">Tên dịch vụ</th>
                            <th scope="col">Mô tả</th>
                            <th scope="col" class="text-end text-nowrap">Đơn giá</th>
                            <th scope="col" class="text-end text-nowrap">Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2" aria-hidden="true"></i>
                            Chưa có dịch vụ phù hợp. Hãy thêm dịch vụ mới.
                        </td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="service-code">@item.MaDichVu</span></td>
                                <td class="fw-semibold">@item.TenDichVu</td>
                                <td class="service-description">@(string.IsNullOrWhiteSpace(item.MoTa) ? "Chưa có mô tả" : item.MoTa)</td>
                                <td class="text-end text-nowrap fw-semibold">@item.DonGia.ToString("N0") đ</td>
                                <td>
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-madichvu="@item.MaDichVu" class="btn btn-sm btn-outline-primary" title="Sửa dịch vụ" aria-label="Sửa @item.TenDichVu">
                                            <i class="bi bi-pencil-square" aria-hidden="true"></i><span class="d-none d-xl-inline ms-1">Sửa</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-madichvu="@item.MaDichVu" class="btn btn-sm btn-outline-danger" title="Xóa dịch vụ" aria-label="Xóa @item.TenDichVu">
                                            <i class="bi bi-trash3" aria-hidden="true"></i><span class="d-none d-xl-inline ms-1">Xóa</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .service-page { color: #172033; }
    .service-card { border-radius: 14px; }
    .service-table thead th { background: #f5f7fb; color: #5b6475; font-size: .82rem; font-weight: 700; border-bottom: 1px solid #e5e9f0; padding: .9rem .85rem; }
    .service-table tbody td { padding: .9rem .85rem; border-color: #edf0f5; }
    .service-code { display: inline-block; padding: .25rem .5rem; border-radius: 6px; background: #eef4ff; color: #2457b2; font-size: .82rem; font-weight: 700; }
    .service-description { min-width: 180px; max-width: 420px; color: #687386; }
    .service-table .btn { white-space: nowrap; }
</style>
