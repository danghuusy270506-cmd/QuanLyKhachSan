@model QuanLyKhachSan.Models.Entities.DichVu
@{
    ViewData["Title"] = "Thêm dịch vụ";
}
<div class="container-fluid py-3">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i> Quay lại danh sách</a>
        <h1 class="h3 fw-bold mt-2 mb-1">Thêm dịch vụ</h1>
        <p class="text-muted mb-0">Nhập thông tin dịch vụ mới của khách sạn.</p>
    </div>
    <div class="card border-0 shadow-sm" style="max-width: 760px; border-radius: 14px;">
        <div class="card-body p-4">
            <!-- Gọi Partial ra đây -->
            <partial name="_CreatePartial" model="Model" />
        </div>
    </div>
</div>