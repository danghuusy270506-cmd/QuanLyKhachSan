@model QuanLyKhachSan.Models.Entities.DichVu
@{
    ViewData["Title"] = "Sửa dịch vụ";
}
<div class="container-fluid py-3">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i> Quay lại danh sách</a>
        <h1 class="h3 fw-bold mt-2 mb-1">Sửa dịch vụ</h1>
        <p class="text-muted mb-0">Cập nhật thông tin dịch vụ @Model.MaDichVu.</p>
    </div>
    <div class="card border-0 shadow-sm" style="max-width: 760px; border-radius: 14px;">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-madichvu="@Model.MaDichVu" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="MaDichVu" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mã dịch vụ</label>
                    <input value="@Model.MaDichVu" class="form-control" readonly />
                </div>
                <div class="mb-3">
                    <label asp-for="TenDichVu" class="form-label fw-semibold"></label>
                    <input asp-for="TenDichVu" class="form-control" />
                    <span asp-validation-for="TenDichVu" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label fw-semibold"></label>
                    <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="DonGia" class="form-label fw-semibold">Đơn giá (VNĐ)</label>
                    <div class="input-group">
                        <input asp-for="DonGia" class="form-control" type="number" min="0" step="1000" />
                        <span class="input-group-text">đ</span>
                    </div>
                    <span asp-validation-for="DonGia" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
