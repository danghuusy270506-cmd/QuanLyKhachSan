
@using System.Globalization
@model QuanLyKhachSan.Models.Entities.LoaiPhong

@{
    Layout = "_ClientLayout";
    ViewData["Title"] = Model.TenLoaiPhong;

    var culture = CultureInfo.GetCultureInfo("vi-VN");

    var fallbackImage =
        "https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=1200&q=85";

    var imageUrl = string.IsNullOrWhiteSpace(Model.Anh)
        ? fallbackImage
        : Model.Anh;
}

<!-- ĐƯỜNG DẪN -->
<section class="client-detail-breadcrumb">
    <div class="client-container">

        <a asp-controller="Home"
           asp-action="ClientIndex">
            Trang chủ
        </a>

        <i class="bi bi-chevron-right"></i>

        <a asp-controller="ClientLoaiPhong"
           asp-action="Index">
            Loại phòng
        </a>

        <i class="bi bi-chevron-right"></i>

        <span>@Model.TenLoaiPhong</span>

    </div>
</section>

<!-- CHI TIẾT LOẠI PHÒNG -->
<section class="client-room-detail-section">
    <div class="client-container">

        <div class="client-room-detail-grid">

            <!-- ẢNH LOẠI PHÒNG -->
            <div class="client-room-detail-gallery">

                <div class="client-room-detail-main-image">
                    <img src="@imageUrl"
                         alt="@Model.TenLoaiPhong"
                         onerror="this.onerror=null;this.src='@fallbackImage';" />
                </div>

                <div class="client-room-detail-image-caption">
                    <i class="bi bi-buildings"></i>
                    <span>Không gian nghỉ ngơi của bạn</span>
                </div>

            </div>

            <!-- THÔNG TIN -->
            <div class="client-room-detail-info">

                <span class="client-room-detail-eyebrow">
                    HOTEL & STAY · ACCOMMODATION
                </span>

                <h1>@Model.TenLoaiPhong</h1>

                <p class="client-room-detail-description">
                    @(string.IsNullOrWhiteSpace(Model.MoTa)
                        ? "Không gian nghỉ ngơi thoải mái cho kỳ lưu trú của bạn."
                        : Model.MoTa)
                </p>

                <div class="client-room-detail-divider"></div>

                <div class="client-room-detail-feature">

                    <div class="client-room-detail-feature-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <div>
                        <span>Sức chứa tối đa</span>
                        <strong>@Model.SucChua người</strong>
                    </div>

                </div>

                <div class="client-room-detail-divider"></div>

                <div class="client-room-detail-price-block">

                    <span>Giá phòng tham khảo</span>

                    <div class="client-room-detail-price">
                        @Model.GiaPhong.ToString("N0", culture)
                        <small>VNĐ</small>
                    </div>

                    <p>Giá cho một đêm lưu trú.</p>

                </div>

                <div class="client-room-detail-actions">

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a class="client-btn client-btn-primary client-room-book-btn"
                           asp-controller="DangNhap"
                           asp-action="Authentication">
                            <i class="bi bi-calendar-check"></i>
                            Đăng nhập để đặt phòng
                        </a>
                    }
                    else if (User.IsInRole("KhachHang"))
                    {
                        <div class="client-room-detail-note">
                            <i class="bi bi-info-circle"></i>

                            
                            <a asp-controller="ClientDatPhong"
                               asp-action="Create"
                               asp-route-maLoaiPhong="@Model.MaLoaiPhong"
                               class="btn btn-primary">
                                Đặt phòng này
                            </a>

                        </div>
                    }

                    <a class="client-room-back-link"
                       asp-controller="ClientLoaiPhong"
                       asp-action="Index">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại danh sách loại phòng
                    </a>

                </div>

            </div>

        </div>

        <!-- PHẦN GIỚI THIỆU CUỐI TRANG -->
        <div class="client-room-detail-note-panel">

            <i class="bi bi-stars"></i>

            <div>
                <h2>Tìm không gian phù hợp với bạn</h2>

                <p>
                    Hãy xem kỹ mô tả, sức chứa và giá phòng trước
                    khi lựa chọn loại phòng cho chuyến đi.
                </p>
            </div>

        </div>

    </div>
</section>
