@model QuanLyKhachSan.Models.Entities.NhanVien

<!-- Modal Header -->
<div class="modal-header bg-dark text-white py-3 px-4 border-0">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-pencil-square text-warning fs-4"></i>
        <h5 class="modal-title fw-bold fs-5 mb-0">
            Chỉnh sửa nhân viên: <span class="text-warning">@Model.HoTen</span>
        </h5>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="editNhanVienForm" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <!-- Modal Body nền xám nhạt -->
    <div class="modal-body p-4 bg-light">

        <!-- Tổng hợp lỗi (nếu có) -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-danger-subtle bg-danger-subtle text-danger mb-4"></div>

        <input type="hidden" asp-for="MaNhanVien" id="MaNhanVien" />
        <input type="hidden" asp-for="MaTaiKhoan" />

        <!-- Khối form nhập liệu (Card trắng) -->
        <div class="bg-white rounded-3 shadow-sm border border-light p-4">

            <!-- Họ tên -->
            <div class="mb-4">
                <label asp-for="HoTen" class="form-label fs-6 fw-semibold text-muted">
                    Họ và Tên <span class="text-danger">*</span>
                </label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                    <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên đầy đủ" />
                </div>
                <span asp-validation-for="HoTen" class="text-danger small fw-medium mt-1 d-block"></span>
            </div>

            <div class="row">
                <!-- CCCD -->
                <div class="col-md-6 mb-4">
                    <label asp-for="Cccd" class="form-label fs-6 fw-semibold text-muted">Số CCCD / CMND</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light"><i class="bi bi-card-text"></i></span>
                        <input asp-for="Cccd" class="form-control" placeholder="Nhập số CCCD" />
                    </div>
                    <span asp-validation-for="Cccd" class="text-danger small fw-medium mt-1 d-block"></span>
                </div>

                <!-- SĐT -->
                <div class="col-md-6 mb-4">
                    <label asp-for="Sdt" class="form-label fs-6 fw-semibold text-muted">Số điện thoại</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                        <input asp-for="Sdt" class="form-control" placeholder="Nhập số điện thoại" />
                    </div>
                    <span asp-validation-for="Sdt" class="text-danger small fw-medium mt-1 d-block"></span>
                </div>
            </div>

            <!-- Email -->
            <div class="mb-4">
                <label asp-for="Email" class="form-label fs-6 fw-semibold text-muted">Địa chỉ Email</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" type="email" class="form-control" placeholder="example@domain.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small fw-medium mt-1 d-block"></span>
            </div>

            <!-- Mã tài khoản (Readonly) -->
            <div class="mb-2">
                <label class="form-label fs-6 fw-semibold text-muted">Mã tài khoản liên kết</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-light"><i class="bi bi-shield-lock"></i></span>
                    <input type="text" class="form-control bg-light text-muted fw-bold" value="@Model.MaTaiKhoan" disabled readonly />
                </div>
                <small class="text-muted mt-1 d-block fst-italic">Không thể thay đổi tài khoản liên kết tại đây.</small>
            </div>

        </div>
    </div>

    <!-- Modal Footer -->
    <div class="modal-footer bg-white py-3 px-4 border-top d-flex justify-content-between align-items-center">
        <button type="button" class="btn btn-outline-secondary px-4 py-2 fs-6 fw-medium rounded-pill d-inline-flex align-items-center gap-1" data-bs-dismiss="modal">
            <i class="bi bi-x-lg"></i> Hủy
        </button>
        <button type="button" id="saveEditBtn" class="btn btn-warning text-dark px-4 py-2 fs-6 fw-semibold rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-5"></i> Lưu thay đổi
        </button>
    </div>
</form>

<style>
    .bg-danger-subtle {
        background-color: #f8d7da !important;
    }

    .border-danger-subtle {
        border-color: #f5c2c7 !important;
    }

    /* Tinh chỉnh input để to rõ hơn */
    .input-group-lg > .form-control,
    .input-group-lg > .input-group-text {
        font-size: 1rem;
        padding: 0.75rem 1rem;
    }

    .input-group-text {
        color: #64748b;
    }
</style>