@model QuanLyKhachSan.Models.Entities.NhanVien

<!-- Modal Header -->
<div class="modal-header bg-dark text-white py-3 px-4 border-0">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-person-vcard text-info fs-4"></i>
        <h5 class="modal-title fw-bold fs-5 mb-0">
            Chi tiết nhân viên: <span class="text-info">#@Model.MaNhanVien</span>
        </h5>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<!-- Modal Body nền xám nhạt -->
<div class="modal-body p-4 bg-light">

    <!-- Khối 1: Thông tin cơ bản -->
    <div class="bg-white rounded-3 shadow-sm border border-light p-4 mb-4">

        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
            <div class="text-muted fs-6 fw-semibold">
                <i class="bi bi-hash me-2 fs-5"></i> Mã nhân viên
            </div>
            <div class="fw-bold text-dark fs-5">#@Model.MaNhanVien</div>
        </div>

        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
            <div class="text-muted fs-6 fw-semibold">
                <i class="bi bi-person me-2 fs-5"></i> Họ và tên
            </div>
            <div class="fw-bold text-dark fs-5">@Model.HoTen</div>
        </div>

        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
            <div class="text-muted fs-6 fw-semibold">
                <i class="bi bi-card-text me-2 fs-5"></i> Số CCCD
            </div>
            <div class="text-dark fs-6">
                @(string.IsNullOrEmpty(Model.Cccd) ? "Chưa cập nhật" : Model.Cccd)
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-3">
            <div class="text-muted fs-6 fw-semibold">
                <i class="bi bi-telephone me-2 fs-5"></i> Số điện thoại
            </div>
            <div class="text-dark fs-6">
                @(string.IsNullOrEmpty(Model.Sdt) ? "Chưa cập nhật" : Model.Sdt)
            </div>
        </div>

    </div>

    <!-- Khối 2: Tài khoản & Email -->
    <div class="bg-white rounded-3 shadow-sm border border-light p-4">
        <div class="row align-items-center">

            <!-- Cột Email -->
            <div class="col-md-6 mb-3 mb-md-0">
                <div class="text-muted fs-6 fw-semibold mb-1">
                    <i class="bi bi-envelope me-2 fs-5"></i> Địa chỉ Email
                </div>
                <div class="fw-semibold text-dark fs-6 text-break">
                    @(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)
                </div>
            </div>

            <!-- Cột Tài khoản -->
            <div class="col-md-6 text-md-end">
                <div class="text-muted fs-6 fw-semibold mb-2">
                    <i class="bi bi-shield-lock me-2 fs-5"></i> Mã tài khoản
                </div>
                <div>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill fs-6 fw-bold">
                        <i class="bi bi-key-fill me-1"></i> ID: @Model.MaTaiKhoan
                    </span>
                </div>
            </div>

        </div>
    </div>

</div>

<!-- Modal Footer -->
<!-- Bạn có thể giữ lại nút Đóng nếu muốn -->
<div class="modal-footer bg-white py-3 px-4 border-top d-flex justify-content-between align-items-center">
    <span class="text-muted small"><i class="bi bi-info-circle me-1"></i> Thông tin nhân viên được bảo mật</span>
    <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-medium rounded-pill d-inline-flex align-items-center gap-1" data-bs-dismiss="modal">
        <i class="bi bi-x-lg"></i> Đóng
    </button>
</div>

<style>
    /* Bổ sung CSS cho các class subtle */
    .bg-secondary-subtle {
        background-color: #e2e3e5 !important;
    }

    .border-secondary-subtle {
        border-color: #d3d6d8 !important;
    }

    /* Tinh chỉnh cho icon thẳng hàng với chữ */
    .modal-body i {
        vertical-align: middle;
    }
</style>