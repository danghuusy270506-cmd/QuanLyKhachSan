@model QuanLyKhachSan.Models.Entities.NhanVien

<div class="modal-header bg-dark text-white py-3 px-4">
    <h5 class="modal-title fs-6">
        <i class="bi bi-person-badge me-2"></i>Chi tiết nhân viên: <span class="text-info">#@Model.MaNhanVien</span>
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4 bg-white">
    <dl class="row mb-0 fs-6 gy-2">
        <dt class="col-sm-3 text-muted">Mã nhân viên:</dt>
        <dd class="col-sm-9 fw-bold">#@Model.MaNhanVien</dd>

        <dt class="col-sm-3 text-muted">Họ và tên:</dt>
        <dd class="col-sm-9 fw-bold text-primary">@Model.HoTen</dd>

        <dt class="col-sm-3 text-muted">Mã Tài Khoản:</dt>
        <dd class="col-sm-9">
            <span class="badge bg-secondary">ID: @Model.MaTaiKhoan</span>
        </dd>

        <dt class="col-sm-3 text-muted">Số CCCD:</dt>
        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Cccd) ? "Chưa cập nhật" : Model.Cccd)</dd>

        <dt class="col-sm-3 text-muted">Số điện thoại:</dt>
        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Sdt) ? "Chưa cập nhật" : Model.Sdt)</dd>

        <dt class="col-sm-3 text-muted">Email:</dt>
        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</dd>
    </dl>
</div>

<div class="modal-footer bg-light justify-content-start py-3 px-4">
    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
        <i class="bi bi-x-lg me-1"></i> Đóng
    </button>
</div>