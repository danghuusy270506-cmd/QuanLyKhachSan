@model IEnumerable<QuanLyKhachSan.Models.Entities.NhanVien>

@{
    ViewData["Title"] = "Quản lý nhân viên";
    string searchString = ViewBag.SearchString as string ?? "";
}
<link rel="stylesheet" href="~/css/NhanVien/Index.css" />

<!-- Nút thêm mới (nếu cần) - Giữ nguyên form giống Phòng -->
<div class="d-flex justify-content-end mb-3">
    <!-- Nếu bạn có chức năng thêm nhân viên, hãy thêm nút này và ID Modal tương ứng -->
    <!-- <button type="button" id="btnOpenCreateModal" class="btn btn-dark fw-semibold px-3 py-2 rounded-2">
        <i class="bi bi-plus-lg me-1"></i> Thêm Nhân Viên Mới
    </button> -->
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Khu vực Lọc dữ liệu -->
@await Html.PartialAsync("_FilterPartial", new QuanLyKhachSan.Models.ViewModels.FilterViewModel
{
    ActionUrl = Url.Action("Index", "NhanVien"),
    Placeholder = "Nhập tên, số điện thoại, email hoặc CCCD...",
    SearchParamName = "searchString",
    SearchValue = ViewBag.SearchString
})
<!-- Modal hiển thị chi tiết nhân viên -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden" id="detailModalContent">
        </div>
    </div>
</div>

<!-- Modal chỉnh sửa nhân viên -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden" id="editModalContent">
        </div>
    </div>
</div>

<!-- Modal xóa nhân viên -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden" id="deleteModalContent">
        </div>
    </div>
</div>

<!-- KHUNG CHỨA BẢNG DỮ LIỆU (Được cập nhật qua AJAX) -->
<div id="tableContainer">
    <partial name="_NhanVienPartial" model="Model" />
</div>

@section Scripts {
    <script src="~/js/NhanVien/Index.js"></script>
}