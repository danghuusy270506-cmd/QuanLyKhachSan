@model IEnumerable<QuanLyKhachSan.Models.Entities.NhanVien>

@{
    ViewData["Title"] = "Danh sách Nhân viên";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchString = ViewBag.SearchString ?? "";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary"><i class="bi bi-people-fill me-2"></i>Quản lý Nhân viên</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Form Tìm kiếm -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-10">
                    <input type="text" name="searchString" class="form-control"
                           placeholder="Nhập tên, số điện thoại hoặc CCCD cần tìm..." value="@searchString" />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã NV</th>
                            <th>Họ và Tên</th>
                            <th>Tài khoản ID</th>
                            <th>Số điện thoại</th>
                            <th>CCCD</th>
                            <th>Email</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>#@item.MaNhanVien</strong></td>
                                    <td>@item.HoTen</td>
                                    <td>
                                        <span class="badge bg-secondary">ID: @item.MaTaiKhoan</span>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(item.Sdt) ? "—" : item.Sdt)</td>
                                    <td>@(string.IsNullOrEmpty(item.Cccd) ? "—" : item.Cccd)</td>
                                    <td>@(string.IsNullOrEmpty(item.Email) ? "—" : item.Email)</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.MaNhanVien" class="btn btn-warning" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.MaNhanVien" class="btn btn-info text-white" title="Chi tiết">
                                                <i class="bi bi-eye"></i> Xem
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MaNhanVien" class="btn btn-danger" title="Xóa">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    Không tìm thấy dữ liệu nhân viên nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Thanh Phân trang -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-middle py-3">
                <small class="text-muted">Trang @currentPage / @totalPages (Tổng @ViewBag.TotalItems nhân viên)</small>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@searchString">Trước</a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@searchString">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@searchString">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>