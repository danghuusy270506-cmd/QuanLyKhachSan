@model QuanLyKhachSan.Models.Entities.NhanVien

@{
    ViewData["Title"] = "Xác nhận xóa Nhân viên";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận Xóa Nhân viên</h4>
        </div>
        <div class="card-body">
            <p class="text-danger fw-bold">Bạn có chắc chắn muốn xóa thông tin nhân viên dưới đây khỏi hệ thống?</p>

            <div class="alert alert-light border">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Mã nhân viên:</dt>
                    <dd class="col-sm-8">#@Model.MaNhanVien</dd>

                    <dt class="col-sm-4 text-muted">Họ và Tên:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.HoTen</dd>

                    <dt class="col-sm-4 text-muted">Số điện thoại:</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Sdt) ? "—" : Model.Sdt)</dd>

                    <dt class="col-sm-4 text-muted">Email:</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</dd>
                </dl>
            </div>

            <form asp-action="Delete" method="post" class="mt-3">
                <input type="hidden" asp-for="MaNhanVien" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-1"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill me-1"></i> Đồng ý Xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>