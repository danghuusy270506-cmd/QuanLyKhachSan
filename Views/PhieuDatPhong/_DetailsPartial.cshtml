<!-- ===== FILE: _DetailsPartial.cshtml ===== -->
@model QuanLyKhachSan.Models.Entities.PhieuDatPhong
<link rel="stylesheet" href="~/css/PhieuDatPhong/Details.css" />

<div class="modal-header detail-modal-header d-flex justify-content-between align-items-center">
    <h5 class="modal-title mb-0">
        <i class="bi bi-journal-text me-2 text-primary"></i> Chi tiết phiếu đặt: <span class="text-primary">#@Model.MaPhieu</span>
    </h5>
    <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-0">
    <div class="table-responsive">
        <table class="table table-detail-modern">
            <tbody>
                <tr><th><i class="bi bi-hash text-muted me-2"></i>Mã phiếu đặt</th><td class="fw-bold">#@Model.MaPhieu</td></tr>
                <tr><th><i class="bi bi-person text-muted me-2"></i>Khách hàng đặt</th><td class="fw-bold text-dark fs-6">@(Model.KhachHang?.HoTen ?? "N/A")</td></tr>
                <tr><th><i class="bi bi-door-open text-muted me-2"></i>Loại phòng chọn</th><td><span class="text-primary fw-bold">@(Model.LoaiPhong?.TenLoaiPhong ?? "N/A")</span></td></tr>
                <tr><th><i class="bi bi-calendar-check text-muted me-2"></i>Thời gian nhận phòng</th><td><span class="text-success fw-bold"><i class="bi bi-arrow-right-short"></i> @Model.NgayDen.ToString("dd/MM/yyyy")</span></td></tr>
                <tr><th><i class="bi bi-calendar-x text-muted me-2"></i>Thời gian trả phòng</th><td><span class="text-danger fw-bold"><i class="bi bi-arrow-left-short"></i> @Model.NgayDi.ToString("dd/MM/yyyy")</span></td></tr>
                <tr><th><i class="bi bi-people text-muted me-2"></i>Số lượng khách</th><td><span class="badge bg-light text-dark border px-2 py-1">@Model.SoNguoi người</span></td></tr>
                <tr><th><i class="bi bi-cash-stack text-muted me-2"></i>Tiền đặt cọc</th><td><span class="text-danger fw-bold fs-6">@Model.TienCoc.ToString("N0") VNĐ</span></td></tr>
                <tr><th><i class="bi bi-person-badge text-muted me-2"></i>Nhân viên xác nhận</th><td>@(Model.NhanVien?.HoTen ?? "Khách tự đặt Online")</td></tr>
                <tr><th><i class="bi bi-clock-history text-muted me-2"></i>Thời gian tạo phiếu</th><td class="text-secondary">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</td></tr>
                <tr>
                    <th><i class="bi bi-shield-check text-muted me-2"></i>Trạng thái</th>
                    <td>
                        @if (Model.TrangThai == "Chờ xác nhận")
                        {
                            <span class="badge bg-warning text-dark badge-custom">@Model.TrangThai</span>
                        }
                        else if (Model.TrangThai == "Đã xác nhận")
                        {

                            <span class="badge bg-info text-dark badge-custom">@Model.TrangThai</span>
                        }
                        else if (Model.TrangThai == "Đang ở")
                        {

                            <span class="badge bg-primary badge-custom">@Model.TrangThai</span>
                        }
                        else if (Model.TrangThai == "Hoàn thành")
                        {

                            <span class="badge bg-success badge-custom">@Model.TrangThai</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary badge-custom">@Model.TrangThai</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal-footer bg-white px-4 py-3 border-top d-flex justify-content-between align-items-center">
    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">
        <i class="bi bi-x-lg me-1"></i> Đóng
    </button>
</div>