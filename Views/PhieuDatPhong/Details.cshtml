@model QuanLyKhachSan.Models.Entities.PhieuDatPhong

@{
    ViewData["Title"] = "Chi Tiết Phiếu Đặt Phòng";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-info text-white py-3">
                    <h4 class="card-title mb-0 fw-bold"><i class="bi bi-file-earmark-text me-2"></i>Chi Tiết Phiếu Đặt #@Model.MaPhieu</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Khách Hàng đặt</span>
                            <strong class="fs-6 text-dark">@(Model.KhachHang?.HoTen ?? "N/A")</strong>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Loại Phòng chọn</span>
                            <strong class="fs-6 text-primary">@(Model.LoaiPhong?.TenLoaiPhong ?? "N/A")</strong>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Thời Gian Tạo Phiếu</span>
                            <span>@Model.NgayDat.ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Trạng Thái</span>
                            @{
                                var trangThaiClass = Model.TrangThai switch
                                {
                                    "Chờ xác nhận" => "bg-warning text-dark",
                                    "Đã xác nhận" => "bg-success",
                                    "Đang ở" => "bg-primary",
                                    "Chờ thanh toán" => "bg-warning text-dark",
                                    "Hoàn thành" => "bg-success",
                                    "Đã hủy" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @trangThaiClass">
                                @Model.TrangThai
                            </span>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Thời Gian Nhận / Trả Phòng</span>
                            <span class="fw-bold text-success">@Model.NgayDen.ToString("dd/MM/yyyy")</span> ➔ 
                            <span class="fw-bold text-danger">@Model.NgayDi.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Số Lượng Khách</span>
                            <span>@Model.SoNguoi người</span>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Tiền Đặt Cọc</span>
                            <strong class="text-danger fs-5">@Model.TienCoc.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Nhân Viên Xác Nhận</span>
                            <span>@(Model.NhanVien?.HoTen ?? "Khách tự đặt Online")</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay Lại</a>
                        <a asp-action="Edit" asp-route-maphieu="@Model.MaPhieu" class="btn btn-warning px-4 fw-semibold">Chỉnh Sửa</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>