@model IEnumerable<QuanLyKhachSan.Models.Entities.PhieuDatPhong>

@{
    ViewData["Title"] = "Xếp phòng và Check-in";
}

<div class="container mt-4">
    @* <h2 class="mb-4">Danh sách phiếu chờ Check-in</h2> *@

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Khách hàng</th>
                    <th>Loại phòng</th>
                    <th>Ngày đặt</th>
                    <th>Ngày đến</th>
                    <th>Ngày đi</th>
                    <th>Số người</th>
                    <th>Tiền cọc</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var phieu in Model)
                    {
                        <tr>
                            <td>@phieu.MaPhieu</td>

                            <td>
                                @(phieu.KhachHang?.HoTen ?? "Chưa có thông tin")
                            </td>

                            <td>
                                @(phieu.LoaiPhong?.TenLoaiPhong ?? "Chưa xác định")
                            </td>

                            <td>@phieu.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>

                            <td>@phieu.NgayDen.ToString("dd/MM/yyyy")</td>

                            <td>@phieu.NgayDi.ToString("dd/MM/yyyy")</td>

                            <td>@phieu.SoNguoi</td>

                            <td>
                                @phieu.TienCoc.ToString("N0") đ
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @phieu.TrangThai
                                </span>
                            </td>

                            <td>
                                <a asp-controller="ChiTietXepPhong"
                                   asp-action="XepPhong"
                                   asp-route-maPhieu="@phieu.MaPhieu"
                                   class="btn btn-success btn-sm">
                                    Xếp phòng
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-4">
                            Không có phiếu nào đang chờ check-in.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
