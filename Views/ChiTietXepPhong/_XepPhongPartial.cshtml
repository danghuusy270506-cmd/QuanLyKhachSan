@model QuanLyKhachSan.Models.Entities.PhieuDatPhong

<form id="formXepPhongAjax" asp-controller="ChiTietXepPhong" asp-action="XepPhong" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="maPhieu" value="@Model.MaPhieu" />

    <!-- Header của Modal làm nổi bật nghiệp vụ Check-in -->
    <div class="modal-header text-white px-4 py-3" style="background-color: #1a1d20; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem;">
        <h5 class="modal-title fs-6 fw-semibold d-flex align-items-center gap-2 m-0" id="xepPhongModalLabel">
            <i class="bi bi-door-open text-primary fs-5"></i> Check-in — Phiếu đặt phòng <span class="text-primary">#@Model.MaPhieu</span>
        </h5>
        <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body p-0">
        <!-- Bảng thông tin chi tiết dạng lưới -->
        <div class="table-responsive m-0">
            <table class="table table-bordered mb-0 align-middle" style="border-color: #dee2e6;">
                <tbody>
                    <tr>
                        <td class="bg-light fw-medium text-secondary py-2.5 ps-4" style="width: 35%;">
                            <i class="bi bi-hash me-2 text-muted"></i> Mã phiếu đặt
                        </td>
                        <td class="fw-semibold text-dark py-2.5">#@Model.MaPhieu</td>
                    </tr>
                    <tr>
                        <td class="bg-light fw-medium text-secondary py-2.5 ps-4">
                            <i class="bi bi-person me-2 text-muted"></i> Khách hàng đặt
                        </td>
                        <td class="fw-semibold text-dark py-2.5">@(Model.KhachHang?.HoTen ?? "Chưa có thông tin")</td>
                    </tr>
                    <tr>
                        <td class="bg-light fw-medium text-secondary py-2.5 ps-4">
                            <i class="bi bi-door-closed me-2 text-muted"></i> Loại phòng chọn
                        </td>
                        <td class="py-2.5">
                            <span class="text-primary fw-semibold">@(Model.LoaiPhong?.TenLoaiPhong ?? "Chưa xác định")</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="bg-light fw-medium text-secondary py-2.5 ps-4">
                            <i class="bi bi-calendar-event me-2 text-muted"></i> Thời gian nhận phòng
                        </td>
                        <td class="py-2.5 text-success fw-semibold">
                            <i class="bi bi-arrow-right-short fs-5"></i> @Model.NgayDen.ToString("dd/MM/yyyy")
                        </td>
                    </tr>
                    <tr>
                        <td class="bg-light fw-medium text-secondary py-2.5 ps-4">
                            <i class="bi bi-calendar-x me-2 text-muted"></i> Thời gian trả phòng
                        </td>
                        <td class="py-2.5 text-danger fw-semibold">
                            <i class="bi bi-arrow-left-short fs-5"></i> @Model.NgayDi.ToString("dd/MM/yyyy")
                        </td>
                    </tr>
                    <tr>
                        <td class="bg-light fw-medium text-secondary py-2.5 ps-4">
                            <i class="bi bi-people me-2 text-muted"></i> Số lượng khách
                        </td>
                        <td class="py-2.5">
                            <span class="badge bg-light text-dark border px-2 py-1 fw-normal">@Model.SoNguoi người</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="bg-light fw-medium text-secondary py-2.5 ps-4">
                            <i class="bi bi-cash-stack me-2 text-muted"></i> Tiền đặt cọc
                        </td>
                        <td class="py-2.5 text-danger fw-bold">
                            @Model.TienCoc.ToString("N0") VNĐ
                        </td>
                    </tr>
                    <tr>
                        <td class="bg-light fw-medium text-secondary py-2.5 ps-4">
                            <i class="bi bi-shield-check me-2 text-muted"></i> Trạng thái
                        </td>
                        <td class="py-2.5">
                            <span class="badge rounded-pill text-white px-3 py-1" style="background-color: #0dcaf0; font-weight: 500;">
                                @Model.TrangThai
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Phần chọn phòng thực tế -->
        <div class="p-4 bg-white border-top">
            <div class="mb-3">
                <label for="maPhong" class="form-label fw-semibold text-dark">
                    <i class="bi bi-house-check me-1 text-primary"></i> Chọn phòng trống phù hợp:
                </label>

                <select id="maPhong" name="maPhong" class="form-select shadow-none" asp-items="ViewBag.DanhSachPhong" required>
                    <option value="">-- Chọn phòng thực tế --</option>
                </select>

                <!-- Thông báo nếu danh sách phòng trống rỗng -->
                @{
                    var selectList = ViewBag.DanhSachPhong as SelectList;
                    if (selectList == null || !selectList.Any())
                    {
                        <div class="text-danger small mt-2 fw-medium">
                            <i class="bi bi-exclamation-triangle-fill"></i> Hiện không có phòng trống nào phù hợp với loại phòng này hoặc các phòng đều đang bị trùng lịch lưu trú!
                        </div>
                    }
                    else
                    {
                        <div class="form-text text-muted small mt-1">Hệ thống chỉ hiển thị các phòng đúng loại và không bị trùng lịch.</div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Footer nút bấm (Nút xác nhận mặc định bị disabled khi chưa chọn phòng) -->
    <div class="modal-footer px-4 py-3 bg-light border-top d-flex justify-content-between align-items-center" style="border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
        <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-medium bg-white" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i> Đóng
        </button>
        <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-medium shadow-sm" id="btnSubmitCheckIn" style="background-color: #2563eb; border: none;" disabled>
            <i class="bi bi-check-lg me-1"></i> Xác nhận Check-in        </button>
    </div>
</form>