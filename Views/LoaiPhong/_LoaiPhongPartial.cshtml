@model IEnumerable<QuanLyKhachSan.Models.Entities.LoaiPhong>

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="text-muted fs-5"><i class="bi bi-inbox display-6 d-block mb-2"></i> Chưa có loại phòng nào trong hệ thống.</div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-xl-4 col-md-6">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden transition-hover">
                    <!-- Hình ảnh loại phòng -->
                    <div class="position-relative" style="height: 200px; background-color: #f8f9fa;">
                        @if (!string.IsNullOrEmpty(item.Anh))
                        {
                            <img src="@item.Anh" alt="@item.TenLoaiPhong" class="w-100 h-100 object-fit-cover" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                                <i class="bi bi-image fs-1 mb-1"></i>
                                <span class="small">Chưa có ảnh</span>
                            </div>
                        }
                        <!-- Badge Sức chứa -->
                        <span class="position-absolute top-0 end-0 m-3 badge bg-dark bg-opacity-75 backdrop-blur px-3 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-person-fill text-warning me-1"></i> @item.SucChua người
                        </span>
                    </div>

                    <!-- Nội dung card -->
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title fw-bold text-dark mb-2">@item.TenLoaiPhong</h5>

                        <div class="mb-3">
                            <span class="text-primary fw-bold fs-5">@item.GiaPhong.ToString("N0") VNĐ</span>
                            <span class="text-muted small">/ đêm</span>
                        </div>

                        <p class="card-text text-muted small flex-grow-1 mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrEmpty(item.MoTa) ? "Chưa có mô tả chi tiết cho loại phòng này." : item.MoTa)
                        </p>

                        <!-- Thao tác -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <button type="button" data-id="@item.MaLoaiPhong" class="btn btn-sm btn-outline-info rounded-pill px-3 btn-detail">
                                <i class="bi bi-eye me-1"></i> Chi tiết
                            </button>
                            <div class="btn-group">
                                <button type="button" data-id="@item.MaLoaiPhong" class="btn btn-sm btn-light text-warning border-0 rounded-circle p-2 me-1 btn-edit" title="Sửa">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                                <button type="button" data-id="@item.MaLoaiPhong" class="btn btn-sm btn-light text-danger border-0 rounded-circle p-2 btn-delete" title="Xóa">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>