@model QuanLyKhachSan.Models.Entities.LoaiPhong

<!-- Header nền tối giữ nguyên như bạn yêu cầu -->
<div class="modal-header bg-dark text-white py-3 px-4">
    <h5 class="modal-title fw-bold fs-5 d-flex align-items-center">
        <i class="bi bi-trash-fill text-danger me-2"></i>
        <span>Xóa loại phòng:</span>
        <span class="text-danger ms-2">@Model.TenLoaiPhong</span>
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="deleteLoaiPhongForm" asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MaLoaiPhong" />

    <div class="modal-body p-4">
        <!-- Card thông tin loại phòng mở rộng đầy đủ chiều rộng modal -->
        <div class="d-flex align-items-center bg-light p-3 rounded-3 mb-3 border w-100">
            <!-- Thumbnail ảnh lớn gọn gàng -->
            <div class="flex-shrink-0 me-3">
                @if (!string.IsNullOrEmpty(Model.Anh))
                {
                    <img src="@Model.Anh" alt="@Model.TenLoaiPhong" class="rounded-3 border object-fit-cover" style="width: 100px; height: 100px;" />
                }
                else
                {
                    <div class="bg-secondary-subtle text-secondary rounded-3 border d-flex flex-column align-items-center justify-content-center" style="width: 100px; height: 100px;">
                        <i class="bi bi-image fs-3"></i>
                        <span style="font-size: 11px;">Không có ảnh</span>
                    </div>
                }
            </div>

            <!-- Chi tiết thông tin -->
            <div class="flex-grow-1 overflow-hidden">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h5 class="fw-bold text-dark mb-0 text-truncate">@Model.TenLoaiPhong</h5>
                    <span class="badge bg-secondary-subtle text-secondary font-monospace">#@Model.MaLoaiPhong</span>
                </div>
                <div class="text-primary fw-bold mb-1 fs-5">
                    @Model.GiaPhong.ToString("N0") <span class="fs-6 text-muted fw-normal">VNĐ / đêm</span>
                </div>
                <div class="text-muted">
                    <i class="bi bi-people me-1"></i> Sức chứa: <span class="fw-medium text-dark">@Model.SucChua người</span>
                </div>
            </div>
        </div>

        <!-- Khung cảnh báo đỏ nhạt gọn gàng -->
        <div class="alert alert-danger bg-danger-subtle text-danger border-0 p-3 mb-0 rounded-3 d-flex align-items-center gap-2 w-100">
            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
            <div>
                <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa loại phòng này? Thao tác này không thể hoàn tác và ảnh đại diện cũng sẽ bị xóa khỏi hệ thống.
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="modal-footer bg-light px-4 py-3">
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Hủy Bỏ</button>
        <button type="submit" class="btn btn-danger px-4 fw-semibold d-inline-flex align-items-center gap-1">
            <i class="bi bi-trash3-fill me-1"></i> Xác Nhận Xóa
        </button>
    </div>
</form>