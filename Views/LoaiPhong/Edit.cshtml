@model QuanLyKhachSan.Models.Entities.LoaiPhong

@{
    ViewData["Title"] = "Chỉnh Sửa Loại Phòng";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="card-title mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Loại Phòng #@Model.MaLoaiPhong</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaLoaiPhong" />
                        <input type="hidden" asp-for="Anh" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="TenLoaiPhong" class="form-label fw-semibold">Tên Loại Phòng</label>
                                <input asp-for="TenLoaiPhong" class="form-control" />
                                <span asp-validation-for="TenLoaiPhong" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="GiaPhong" class="form-label fw-semibold">Giá Phòng (VNĐ / Đêm)</label>
                                <input asp-for="GiaPhong" type="number" class="form-control" />
                                <span asp-validation-for="GiaPhong" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SucChua" class="form-label fw-semibold">Sức Chứa (Người)</label>
                                <input asp-for="SucChua" type="number" min="1" class="form-control" />
                                <span asp-validation-for="SucChua" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="MoTa" class="form-label fw-semibold">Mô Tả</label>
                                <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="MoTa" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Thay Đổi Ảnh Minh Họa</label>
                                <input type="file" name="anhFile" class="form-control" accept="image/*" onchange="previewEditImage(this);" />
                                
                                <div class="mt-3 text-center">
                                    <p class="mb-1 text-muted small">Ảnh hiện tại / Ảnh mới chọn:</p>
                                    <img id="editImagePreview" src="@(string.IsNullOrEmpty(Model.Anh) ? "#" : Model.Anh)" 
                                         alt="@Model.TenLoaiPhong" 
                                         class="img-thumbnail @(string.IsNullOrEmpty(Model.Anh) ? "d-none" : "")" 
                                         style="max-height: 200px; object-fit: cover;" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay Lại</a>
                            <button type="submit" class="btn btn-warning px-4 fw-semibold">Lưu Thay Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewEditImage(input) {
            const preview = document.getElementById('editImagePreview');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}