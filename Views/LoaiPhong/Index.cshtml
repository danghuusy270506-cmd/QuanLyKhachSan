@model IEnumerable<QuanLyKhachSan.Models.Entities.LoaiPhong>

@{
    ViewData["Title"] = "Danh Sách Loại Phòng";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Create" class="btn btn-success fw-semibold">
            <i class="bi bi-plus-lg me-1"></i> Thêm Loại Phòng Mới
        </a>
    </div>

    <!-- Khung chứa bảng và phân trang AJAX -->
    <div id="loaiPhongTableContainer">
        <partial name="_LoaiPhongPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/js/LoaiPhong/Index.js"></script>
}