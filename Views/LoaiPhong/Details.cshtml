@model QuanLyKhachSan.Models.Entities.LoaiPhong

@{
    ViewData["Title"] = "Chi Tiết Loại Phòng";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-info text-white py-3">
                    <h4 class="card-title mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Chi Tiết Loại Phòng: @Model.TenLoaiPhong</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-5 text-center">
                            @if (!string.IsNullOrEmpty(Model.Anh))
                            {
                                <img src="@Model.Anh" alt="@Model.TenLoaiPhong" class="img-fluid rounded border shadow-sm mb-2" style="max-height: 220px; object-fit: cover; width: 100%;" />
                            }
                            else
                            {
                                <div class="bg-light text-muted border rounded p-5">Chưa có ảnh minh họa</div>
                            }
                        </div>

                        <div class="col-md-7">
                            <h3 class="fw-bold text-dark">@Model.TenLoaiPhong</h3>
                            <h4 class="text-primary fw-bold my-2">@Model.GiaPhong.ToString("N0") VNĐ <small class="fs-6 text-muted">/ đêm</small></h4>
                            <p class="mb-2"><span class="badge bg-info text-dark"><i class="bi bi-person-fill"></i> Sức chứa: @Model.SucChua người</span></p>
                            <hr />
                            <h6 class="fw-bold">Mô tả loại phòng:</h6>
                            <p class="text-secondary">@(string.IsNullOrEmpty(Model.MoTa) ? "Không có mô tả chi tiết." : Model.MoTa)</p>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <h5 class="fw-bold mb-3"><i class="bi bi-door-closed me-2"></i>Các phòng thuộc loại này (@(Model.Phongs?.Count ?? 0) phòng)</h5>
                        @if (Model.Phongs != null && Model.Phongs.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var p in Model.Phongs)
                                {
                                    <span class="badge bg-secondary p-2 fs-6">Phòng @p.MaPhong (@p.TrangThai)</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">Chưa tạo danh sách phòng thuộc loại này.</p>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay Lại</a>
                        <a asp-action="Edit" asp-route-maloaiphong="@Model.MaLoaiPhong" class="btn btn-warning px-4 fw-semibold">Chỉnh Sửa</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>