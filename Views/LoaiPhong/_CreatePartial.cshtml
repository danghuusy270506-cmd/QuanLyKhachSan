@model QuanLyKhachSan.Models.Entities.LoaiPhong

<!-- Header Modal thiết kế màu tối theo mẫu -->
<div class="modal-header bg-dark-header text-white border-0 py-3 px-4">
    <h5 class="modal-title fw-bold d-flex align-items-center fs-6">
        <i class="bi bi-door-open-fill text-primary me-2 fs-5"></i>
        <span>Thêm loại phòng mới</span></span>
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="createLoaiPhongForm">
    <div class="modal-body p-4">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="TenLoaiPhong" class="form-label fw-semibold">Tên Loại Phòng</label>
                <input asp-for="TenLoaiPhong" class="form-control" placeholder="Ví dụ: Phòng Deluxe Hướng Biển..." />
                <span asp-validation-for="TenLoaiPhong" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="GiaPhong" class="form-label fw-semibold">Giá Phòng (VNĐ / Đêm)</label>
                <input asp-for="GiaPhong" type="number" step="10000" class="form-control" placeholder="Ví dụ: 500000" />
                <span asp-validation-for="GiaPhong" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="SucChua" class="form-label fw-semibold">Sức Chứa (Người)</label>
                <input asp-for="SucChua" type="number" min="1" max="20" class="form-control" placeholder="Ví dụ: 2" />
                <span asp-validation-for="SucChua" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="MoTa" class="form-label fw-semibold">Mô Tả Loại Phòng</label>
                <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Nhập các tiện ích, đặc điểm của loại phòng..."></textarea>
                <span asp-validation-for="MoTa" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold">Hình Ảnh Minh Họa</label>
                <input type="file" name="anhFile" id="anhFileInput" class="form-control" accept="image/*" onchange="previewImage(this);" />
                <div class="mt-2 text-center">
                    <img id="imagePreview" src="#" alt="Xem trước ảnh" class="img-thumbnail d-none" style="max-height: 200px; object-fit: cover;" />
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer bg-light px-4 py-3 border-top-0">
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Hủy Bỏ</button>
        <button type="submit" class="btn btn-primary px-4 fw-semibold">Lưu Loại Phòng</button>
    </div>
</form>

<style>
    /* Style nền Header tối màu giống ảnh mẫu */
    .bg-dark-header {
        background-color: #0d1117 !important;
    }
</style>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
<script>
    function previewImage(input) {
        const preview = document.getElementById('imagePreview');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.classList.remove('d-none');
            }
            reader.readAsDataURL(input.files[0]);
        } else {
            preview.src = "#";
            preview.classList.add('d-none');
        }
    }
</script>