@model IEnumerable<QuanLyKhachSan.Models.Entities.Phong>

@{
    ViewData["Title"] = "Danh Sách Phòng";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-primary mb-0"><i class="bi bi-door-closed-fill me-2"></i>Danh Sách Phòng</h3>
        <a asp-action="Create" class="btn btn-success fw-semibold">
            <i class="bi bi-plus-lg me-1"></i> Thêm Phòng Mới
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Số Phòng</th>
                            <th>Tầng</th>
                            <th>Loại Phòng</th>
                            <th>Giá Phòng</th>
                            <th>Trạng Thái</th>
                            <th class="text-center" style="width: 200px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Chưa có phòng nào trong hệ thống.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark fs-6">Phòng @item.SoPhong</td>
                                    <td><span class="badge bg-light text-dark border">Tầng @item.Tang</span></td>
                                    <td class="fw-semibold text-primary">@(item.LoaiPhong?.TenLoaiPhong ?? "N/A")</td>
                                    <td class="fw-bold">
                                        @(item.LoaiPhong != null ? item.LoaiPhong.GiaPhong.ToString("N0") + " VNĐ" : "N/A")
                                    </td>
                                    <td>
                                        @if (item.TrangThai == "Trống")
                                        {
                                            <span class="badge bg-success">Trống</span>
                                        }
                                        else if (item.TrangThai == "Đang sử dụng")
                                        {
                                            <span class="badge bg-danger">Đang sử dụng</span>
                                        }
                                        else if (item.TrangThai == "Bảo trì")
                                        {
                                            <span class="badge bg-warning text-dark">Bảo trì</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.MaPhong" class="btn btn-outline-info" title="Xem chi tiết"><i class="bi bi-eye"></i> Xem</a>
                                            <a asp-action="Edit" asp-route-id="@item.MaPhong" class="btn btn-outline-warning" title="Sửa"><i class="bi bi-pencil"></i> Sửa</a>
                                            <a asp-action="Delete" asp-route-id="@item.MaPhong" class="btn btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i> Xóa</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>