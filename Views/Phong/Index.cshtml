@model IEnumerable<QuanLyKhachSan.Models.Entities.Phong>

@{
    ViewData["Title"] = "Danh Sách Phòng";
    var dsLoaiPhong = ViewBag.DanhSachLoaiPhong as List<string> ?? new List<string>();
    var selectedLoaiPhong = ViewBag.tenLoaiPhong as string;
    var selectedTrangThai = ViewBag.TrangThai as string;

    // Sử dụng StringBuilder hoặc tag helper để tránh lỗi biên dịch C#
    System.Text.StringBuilder sbFilters = new System.Text.StringBuilder();
    sbFilters.Append("<div class='row g-2'>");

    // Cột Loại Phòng
    sbFilters.Append("<div class='col-6'>");
    sbFilters.Append("<label class='form-label fw-semibold text-muted small'>Loại phòng</label>");
    sbFilters.Append("<select name='tenLoaiPhong' class='form-select'>");
    sbFilters.Append("<option value='Tất cả'>Tất cả loại phòng</option>");
    foreach (var loai in dsLoaiPhong)
    {
        string selected = (selectedLoaiPhong == loai) ? "selected" : "";
        sbFilters.Append($"<option value='{loai}' {selected}>{loai}</option>");
    }
    sbFilters.Append("</select>");
    sbFilters.Append("</div>");

    // Cột Trạng Thái
    sbFilters.Append("<div class='col-6'>");
    sbFilters.Append("<label class='form-label fw-semibold text-muted small'>Trạng thái</label>");
    sbFilters.Append("<select name='trangThai' class='form-select'>");
    sbFilters.Append($"<option value='Tất cả' {(selectedTrangThai == "Tất cả" || string.IsNullOrEmpty(selectedTrangThai) ? "selected" : "")}>Tất cả</option>");
    sbFilters.Append($"<option value='Trống' {(selectedTrangThai == "Trống" ? "selected" : "")}>Trống</option>");
    sbFilters.Append($"<option value='Đang ở' {(selectedTrangThai == "Đang ở" || selectedTrangThai == "Đang sử dụng" ? "selected" : "")}>Đang ở</option>");
    sbFilters.Append($"<option value='Đang dọn dẹp' {(selectedTrangThai == "Đang dọn dẹp" ? "selected" : "")}>Đang dọn dẹp</option>");
    sbFilters.Append($"<option value='Bảo trì' {(selectedTrangThai == "Bảo trì" ? "selected" : "")}>Bảo trì</option>");
    sbFilters.Append("</select>");
    sbFilters.Append("</div>");

    sbFilters.Append("</div>");

    ViewData["CustomFilters"] = sbFilters.ToString();
}

<link rel="stylesheet" href="~/css/Phong/Index.css" />

<div class="d-flex justify-content-end mb-3">
    <button type="button" id="btnOpenCreateModal" class="btn btn-dark fw-semibold px-3 py-2 rounded-2">
        <i class="bi bi-plus-lg me-1"></i> Thêm Phòng Mới
    </button>
</div>

<!-- Khu vực Lọc dữ liệu -->
@await Html.PartialAsync("_FilterPartial", new QuanLyKhachSan.Models.ViewModels.FilterViewModel
{
    ActionUrl = Url.Action("Index", "Phong"),
    Placeholder = "Nhập số phòng...",
    SearchParamName = "soPhong",
    SearchValue = ViewBag.soPhong
})

<!-- Khung Modal hiển thị chi tiết phòng -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden" id="detailModalContent">
        </div>
    </div>
</div>

<!-- Khung Modal Chỉnh Sửa -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden" id="editModalContent">
        </div>
    </div>
</div>

<!-- Khung Modal Xóa Phòng -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden" id="deleteModalContent">
        </div>
    </div>
</div>

<!-- Khung Modal Thêm Phòng Mới -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden" id="createModalContent">
        </div>
    </div>
</div>

<!-- Khu vực hiển thị bảng và phân trang AJAX -->
<div id="phongTableContainer">
    <partial name="_PhongPartial" model="Model" />
</div>

@section Scripts {
    <script src="~/js/Phong/Index.js"></script>
}