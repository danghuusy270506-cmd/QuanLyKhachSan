@model QuanLyKhachSan.Models.Entities.Phong

@{
    ViewData["Title"] = "Chi Tiết Phòng";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-info text-white py-3">
                    <h4 class="card-title mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Thông Tin Phòng @Model.SoPhong</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Số Phòng</span>
                            <strong class="fs-5 text-dark">Phòng @Model.SoPhong</strong>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Tầng Khách Sạn</span>
                            <strong class="fs-6">Tầng @Model.Tang</strong>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Loại Phòng</span>
                            <strong class="fs-6 text-primary">@(Model.LoaiPhong?.TenLoaiPhong ?? "N/A")</strong>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Giá Phòng / Đêm</span>
                            <strong class="fs-6 text-danger">@(Model.LoaiPhong != null ? Model.LoaiPhong.GiaPhong.ToString("N0") + " VNĐ" : "N/A")</strong>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Sức Chứa Tối Đa</span>
                            <span>@(Model.LoaiPhong != null ? Model.LoaiPhong.SucChua + " người" : "N/A")</span>
                        </div>
                        <div class="col-sm-6 border-bottom pb-2">
                            <span class="text-muted d-block small">Trạng Thái Hiện Tại</span>
                            <span class="badge bg-success fs-6">@Model.TrangThai</span>
                        </div>
                        <div class="col-12 border-bottom pb-2">
                            <span class="text-muted d-block small">Mô Tả Loại Phòng</span>
                            <p class="mb-0 text-secondary">@(Model.LoaiPhong?.MoTa ?? "Không có mô tả")</p>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay Lại</a>
                        <a asp-action="Edit" asp-route-id="@Model.MaPhong" class="btn btn-warning px-4 fw-semibold">Chỉnh Sửa</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>