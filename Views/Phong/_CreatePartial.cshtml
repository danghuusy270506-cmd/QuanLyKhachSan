@model QuanLyKhachSan.Models.Entities.Phong

<div class="modal-header bg-dark text-white py-3 border-bottom-0">
    <h5 class="modal-title mb-0 fw-bold d-flex align-items-center gap-2" id="createModalLabel">
        <i class="bi bi-plus-square fs-5"></i>
        <span>Thêm phòng mới</span>
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4" id="createPhongFormContainer">
    <form id="createPhongForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="SoPhong" class="form-label fw-semibold">Số Phòng</label>
                <input asp-for="SoPhong" id="createSoPhong" class="form-control" placeholder="Ví dụ: 101, P202..." />
                <span asp-validation-for="SoPhong" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Tang" class="form-label fw-semibold">Tầng</label>
                <input asp-for="Tang" id="createTang" type="number" min="1" max="100" class="form-control" placeholder="Ví dụ: 1" />
                <span asp-validation-for="Tang" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="MaLoaiPhong" class="form-label fw-semibold">Loại Phòng</label>
                <select asp-for="MaLoaiPhong" id="createMaLoaiPhong" class="form-select" asp-items="ViewBag.MaLoaiPhong">
                    <option value="">-- Chọn loại phòng --</option>
                </select>
                <span asp-validation-for="MaLoaiPhong" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="TrangThai" class="form-label fw-semibold">Trạng Thái BAN ĐẦU</label>
                <select asp-for="TrangThai" id="createTrangThai" class="form-select">
                    <option value="Trống">Trống</option>
                    <option value="Đang sử dụng">Đang sử dụng</option>
                    <option value="Đang dọn dẹp">Đang dọn dẹp</option>
                    <option value="Bảo trì">Bảo trì</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Hủy Bỏ</button>
            <button type="button" id="btnSubmitCreate" class="btn btn-primary px-4 fw-semibold">Lưu Phòng</button>
        </div>
    </form>
</div>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}