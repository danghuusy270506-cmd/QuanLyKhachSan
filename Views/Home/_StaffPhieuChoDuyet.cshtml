@model QuanLyKhachSan.Models.ViewModels.StaffDashboardViewModel

<div class="card h-100 shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h6 class="mb-0 fw-bold">
            📋 Phiếu chờ xác nhận
            <span class="badge bg-warning text-dark ms-1">@Model.PhieuChoXacNhan</span>
        </h6>
        <a asp-controller="PhieuDatPhong" asp-action="Index"
           class="btn btn-sm btn-outline-primary">Xem tất cả</a>
    </div>
    @if (!Model.PhieuChoDuyet.Any())
    {
        <div class="card-body text-muted text-center py-5">
            <i class="bi bi-check-circle fs-1 text-success d-block mb-2"></i>
            Không có phiếu nào chờ duyệt
        </div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var p in Model.PhieuChoDuyet)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h6 class="mb-1 fw-bold">@p.KhachHang?.HoTen</h6>
                        <span class="text-muted small d-block">@p.LoaiPhong?.TenLoaiPhong</span>
                        <small class="text-secondary" style="font-size: 11px;">
                            <i class="bi bi-clock"></i> @p.NgayDat.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <!-- Gắn mã phiếu vào data-id và thêm onclick để test -->
                        <button type="button" class="btn btn-success btn-duyet" data-id="@p.MaPhieu">Duyệt</button>
                        <button type="button" class="btn btn-outline-danger btn-huy" data-id="@p.MaPhieu">Hủy</button>
                    </div>
                </div>
            }
        </div>
    }
</div>