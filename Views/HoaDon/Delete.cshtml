@model QuanLyKhachSan.Models.Entities.HoaDon

@{
    ViewData["Title"] = "Xóa hóa đơn";
}

<div class="container mt-4 mb-5" style="max-width: 700px;">
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">

        <!-- Header Card màu tối -->
        <div class="card-header bg-dark text-white py-3 px-4 d-flex align-items-center gap-2 border-0">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
            <h5 class="fw-bold fs-5 mb-0">Xóa hóa đơn: <span class="text-danger">#@Model.MaHoaDon</span></h5>
        </div>

        <div class="card-body p-0">
            <!-- Cảnh báo -->
            <div class="p-3 bg-danger bg-opacity-10 border-bottom border-danger border-opacity-25 text-danger d-flex align-items-center gap-2 px-4">
                <i class="bi bi-info-circle-fill fs-5"></i>
                <span class="fw-medium">Bạn có chắc chắn muốn xóa hóa đơn này không? Hành động này không thể hoàn tác.</span>
            </div>

            <!-- Danh sách chi tiết -->
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex align-items-center py-3 px-4 border-bottom">
                    <div class="text-secondary fw-medium d-flex align-items-center gap-2" style="width: 40%;">
                        <i class="bi bi-hash fs-5 text-secondary"></i>
                        <span>Mã hóa đơn</span>
                    </div>
                    <div class="fw-bold text-dark" style="width: 60%;">
                        #@Model.MaHoaDon
                    </div>
                </div>

                <div class="list-group-item d-flex align-items-center py-3 px-4 border-bottom">
                    <div class="text-secondary fw-medium d-flex align-items-center gap-2" style="width: 40%;">
                        <i class="bi bi-bookmark-check fs-5 text-secondary"></i>
                        <span>Mã phiếu đặt phòng</span>
                    </div>
                    <div class="fw-bold text-dark" style="width: 60%;">
                        #@Model.MaPhieu
                    </div>
                </div>

                <div class="list-group-item d-flex align-items-center py-3 px-4">
                    <div class="text-secondary fw-medium d-flex align-items-center gap-2" style="width: 40%;">
                        <i class="bi bi-cash-stack fs-5 text-secondary"></i>
                        <span>Tổng tiền</span>
                    </div>
                    <div class="fw-bold text-danger fs-6" style="width: 60%;">
                        @Model.TongTien.ToString("N0") VNĐ
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Card với các nút bấm bo tròn -->
        <div class="card-footer d-flex justify-content-between align-items-center px-4 py-3 bg-light border-top-0">
            <a asp-controller="HoaDon" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-medium rounded-pill d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>

            <form asp-controller="HoaDon"
                  asp-action="Delete"
                  method="post"
                  class="m-0"
                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa hóa đơn này không?');">

                @Html.AntiForgeryToken()
                <input type="hidden" name="maHoaDon" value="@Model.MaHoaDon" />
                <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-trash-fill"></i> Xác nhận xóa
                </button>
            </form>
        </div>

    </div>
</div>