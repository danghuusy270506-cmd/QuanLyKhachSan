@model QuanLyKhachSan.Models.Entities.HoaDon

<!-- Modal Header -->
<div class="modal-header bg-dark text-white py-3 px-4 border-0">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-receipt text-info fs-4"></i>
        <h5 class="modal-title fw-bold fs-5 mb-0" id="chiTietHoaDonModalLabel">
            Chi tiết hóa đơn: <span class="text-info">#@Model.MaHoaDon</span>
        </h5>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<!-- Modal Body: Giao diện mới phân tách bằng Card và Table -->
<div class="modal-body p-4 bg-light">

    <!-- Khối 1: Thông tin chung (Thẻ) -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-3 bg-white rounded-3 shadow-sm border border-light h-100">
                <div class="text-muted small mb-1">
                    <i class="bi bi-bookmark-check me-1 text-primary"></i> Mã phiếu đặt
                </div>
                <div class="fw-bold fs-5 text-dark">#@Model.MaPhieu</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-white rounded-3 shadow-sm border border-light h-100">
                <div class="text-muted small mb-1">
                    <i class="bi bi-credit-card me-1 text-primary"></i> Kiểu thanh toán
                </div>
                <div class="fw-bold text-dark">
                    @(string.IsNullOrEmpty(Model.KieuThanhToan) ? "Chưa xác định" : Model.KieuThanhToan)
                </div>
            </div>
        </div>
    </div>

    <!-- Khối 2: Chi tiết tính tiền (Table) -->
    <div class="bg-white rounded-3 shadow-sm border border-light overflow-hidden mb-4">
        <table class="table table-hover align-middle mb-0">
            <tbody>
                <tr>
                    <td class="text-secondary py-3 ps-4 border-bottom-0" style="width: 60%;">
                        <i class="bi bi-house-door me-2"></i> Tiền phòng
                    </td>
                    <td class="text-end fw-semibold text-dark py-3 pe-4 border-bottom-0" style="width: 40%;">
                        @(((int)(ViewBag.TienPhong ?? 0)).ToString("N0")) VNĐ
                    </td>
                </tr>
                <tr>
                    <td class="text-secondary py-3 ps-4 border-bottom-0">
                        <i class="bi bi-cup-hot me-2"></i> Tiền dịch vụ
                    </td>
                    <td class="text-end fw-semibold text-dark py-3 pe-4 border-bottom-0">
                        @(((int)(ViewBag.TienDichVu ?? 0)).ToString("N0")) VNĐ
                    </td>
                </tr>
                <tr>
                    <td class="text-secondary py-3 ps-4 border-bottom-0">
                        <i class="bi bi-wallet2 me-2"></i> Tiền cọc
                    </td>
                    <td class="text-end fw-semibold text-dark py-3 pe-4 border-bottom-0">
                        @Model.TienCoc.ToString("N0") VNĐ
                    </td>
                </tr>
                <tr>
                    <td class="text-secondary py-3 ps-4 border-bottom-0">
                        <i class="bi bi-tag me-2"></i> Giảm giá
                    </td>
                    <td class="text-end fw-semibold text-danger py-3 pe-4 border-bottom-0">
                        - @Model.GiamGia.ToString("N0") VNĐ
                    </td>
                </tr>
            </tbody>
            <!-- Dòng Tổng tiền được làm nổi bật -->
            <tfoot class="border-top border-2 border-dark">
                <tr class="bg-light">
                    <td class="fw-bold text-dark py-3 ps-4 fs-5">TỔNG THANH TOÁN</td>
                    <td class="text-end fw-bold text-danger py-3 pe-4 fs-4">
                        @Model.TongTien.ToString("N0") VNĐ
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Khối 3: Thời gian và Trạng thái -->
    <div class="d-flex justify-content-between align-items-center p-3 bg-white rounded-3 shadow-sm border border-light">
        <div>
            <div class="text-muted small mb-1">
                <i class="bi bi-clock-history me-1"></i> Thời gian thanh toán
            </div>
            <!-- ĐÃ THÊM ID VÀO THẺ DIV NÀY ĐỂ JS BẮT SỰ KIỆN -->
            <div class="fw-semibold text-dark" id="modal-thoigian-thanhtoan">
                @if (Model.ThoiGianThanhToan == DateTime.MinValue)
                {
                    <span class="text-muted fst-italic">Chưa thanh toán</span>
                }
                else
                {
                    @Model.ThoiGianThanhToan.ToString("dd/MM/yyyy HH:mm")
                }
            </div>
        </div>
        <div class="text-end">
            <div class="text-muted small mb-1">
                <i class="bi bi-shield-check me-1"></i> Trạng thái
            </div>
            <!-- ĐÃ THÊM ID VÀO THẺ DIV NÀY ĐỂ JS BẮT SỰ KIỆN -->
            <div id="modal-trangthai-thanhtoan">
                @if (Model.TrangThai == "DaThanhToan")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i> Đã thanh toán
                    </span>
                }
                else if (Model.TrangThai == "DaHoanTien")
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Đã hoàn tiền
                    </span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-exclamation-circle-fill me-1"></i> Chưa thanh toán
                    </span>
                }
            </div>
        </div>
    </div>

</div>

<!-- Modal Footer -->
<div class="modal-footer bg-white py-3 px-4 border-top d-flex justify-content-between align-items-center">
    <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-medium rounded-pill" data-bs-dismiss="modal">
        <i class="bi bi-x-lg me-1"></i> Đóng
    </button>

    <div id="modal-footer-actions">
        @if (Model.TrangThai == "ChuaThanhToan")
        {
            <button type="button" class="btn btn-success px-4 py-2 fw-semibold rounded-pill shadow-sm d-inline-flex align-items-center gap-2 btn-xac-nhan-tien btn-xac-nhan-modal" data-id="@Model.MaHoaDon">
                <i class="bi bi-check-circle-fill fs-5"></i> Xác nhận đã nhận tiền
            </button>
        }
        else
        {
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold rounded-pill d-inline-flex align-items-center gap-1.5" style="font-size: 14px;">
                <i class="bi bi-check-circle-fill text-success"></i> Thanh toán thành công
            </span>
        }
    </div>
</div>

<style>
    .bg-success-subtle {
        background-color: #d1e7dd !important;
    }

    .border-success-subtle {
        border-color: #badbcc !important;
    }

    .bg-warning-subtle {
        background-color: #fff3cd !important;
    }

    .border-warning-subtle {
        border-color: #ffecb5 !important;
    }

    .bg-danger-subtle {
        background-color: #f8d7da !important;
    }

    .border-danger-subtle {
        border-color: #f5c2c7 !important;
    }

    /* Xóa viền mặc định của table để trông mượt hơn */
    .table > :not(caption) > * > * {
        border-bottom-width: 0;
        box-shadow: none;
    }
</style>