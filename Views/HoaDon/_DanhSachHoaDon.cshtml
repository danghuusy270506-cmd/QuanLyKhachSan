@model IEnumerable<QuanLyKhachSan.Models.ViewModels.HoaDonDanhSachViewModel>

@{
    int trangHienTai = ViewBag.TrangHienTai ?? 1;
    int tongTrang = ViewBag.TongTrang ?? 1;
}

<div class="table-responsive hoa-don-table-wrapper">
    <table class="table table-bordered table-hover align-middle hoa-don-table">
        <thead>
            <tr>
                <th>Mã hóa đơn</th>
                <th class="text-center">MÃ PHIẾU</th>
                <th class="text-center">TỔNG TIỀN</th>
                <th class="text-center">THANH TOÁN</th>
                <th class="text-center">THỜI GIAN THANH TOÁN</th>
                <th class="text-center">TRẠNG THÁI</th>
                <th class="text-center">THAO TÁC</th>
                <th class="text-center">THANH TOÁN</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                @foreach (var hd in Model)
                {
                    <tr>
                        <td class="ma-hoa-don ps-3">@hd.MaHoaDon</td>
                        <td class="text-center">@hd.MaPhieu</td>
                        <td class="text-center fw-semibold">@hd.TongTien.ToString("N0") đ</td>
                        <td class="text-center">@hd.KieuThanhToan</td>
                        <td class="text-center">
                            @if (hd.ThoiGianThanhToan == DateTime.MinValue)
                            {
                                <span class="text-muted">Chưa thanh toán</span>
                            }
                            else
                            {
                                @hd.ThoiGianThanhToan.ToString("dd/MM/yyyy HH:mm")
                            }
                        </td>
                        <td class="trang-thai-nhan-@hd.MaHoaDon text-center align-middle">
                            @if (hd.TrangThai == "DaThanhToan")
                            {
                                <span class="badge bg-success">Đã thanh toán</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chưa thanh toán</span>
                            }
                        </td>
                        <td class="hoa-don-actions text-center align-middle">
                            <div class="btn-group btn-group-sm shadow-sm inline-flex justify-content-center" role="group" aria-label="Thao tác hóa đơn">
                                <!-- Nút Chi tiết -->
                                <button type="button"
                                        data-id="@hd.MaHoaDon"
                                        class="btn btn-outline-info btn-xem-chi-tiet px-2 py-1"
                                        title="Xem chi tiết">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </button>
                                <!-- Nút Xóa -->
                                    <a asp-action="Delete"
                                    asp-route-maHoaDon="@hd.MaHoaDon"
                                    class="btn btn-outline-danger px-2 py-1 btn-xoa-modal"
                                    title="Xóa hóa đơn">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                            </div>
                        </td>
                        <td class="trang-thai-@hd.MaHoaDon text-center align-middle">
                            @if (hd.TrangThai == "DaThanhToan")
                            {
                                <button type="button" class="btn btn-sm btn-success" disabled>
                                    Xác nhận
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-sm btn-warning text-dark fw-bold btn-xem-chi-tiet"
                                        data-id="@hd.MaHoaDon">
                                    Xác nhận
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-4">
                        Không tìm thấy hóa đơn.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (tongTrang > 1)
{
    <nav class="mt-3 hoa-don-pagination" aria-label="Phân trang hóa đơn">
        <ul class="pagination justify-content-center">
            <li class="page-item @(trangHienTai <= 1 ? "disabled" : "")">
                <a class="page-link ajax-trang"
                   href="@Url.Action("Index", new { page = trangHienTai - 1 })"
                   data-page="@(trangHienTai - 1)">
                    Trước
                </a>
            </li>

            @for (int i = 1; i <= tongTrang; i++)
            {
                <li class="page-item @(i == trangHienTai ? "active" : "")">
                    <a class="page-link ajax-trang"
                       href="@Url.Action("Index", new { page = i })"
                       data-page="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(trangHienTai >= tongTrang ? "disabled" : "")">
                <a class="page-link ajax-trang"
                   href="@Url.Action("Index", new { page = trangHienTai + 1 })"
                   data-page="@(trangHienTai + 1)">
                    Sau
                </a>
            </li>
        </ul>
    </nav>
}

<p class="thong-tin-phan-trang">
    Trang @trangHienTai / @tongTrang — Tổng @ViewBag.TongBanGhi hóa đơn
</p>