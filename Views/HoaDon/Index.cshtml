@model IEnumerable<QuanLyKhachSan.Models.ViewModels.HoaDonDanhSachViewModel>

@{
    ViewData["Title"] = "Danh sách hóa đơn";
}

<link rel="stylesheet" href="~/css/HoaDon/Index.css" asp-append-version="true" />

<div class="container-fluid hoa-don-page">
    @Html.AntiForgeryToken()

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bộ lọc hóa đơn -->
    <div class="filter-container card shadow-sm border-0 rounded-3 p-3 mb-4">
        <form id="formLocHoaDon" asp-controller="HoaDon" asp-action="Index" method="get">
            <div class="row g-3 align-items-end">

                <!-- Mã hóa đơn / mã phiếu -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted small">Mã hóa đơn / phiếu</label>
                    <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Nhập mã..." maxlength="10" />
                </div>

                <!-- Cụm Ngày / Tháng / Năm -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted small">Ngày / Tháng / Năm</label>
                    <div class="d-flex gap-2">
                        <input type="number" name="ngay" value="@ViewBag.NgayLoc" class="form-control" placeholder="Ngày" min="1" max="31" style="width: 33%;" title="Ngày" />
                        <select name="thang" class="form-select" style="width: 34%;" title="Tháng">
                            <option value="">Tháng</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(ViewBag.ThangLoc != null && (int)ViewBag.ThangLoc == i)">@i</option>
                            }
                        </select>
                        <input type="number" name="nam" value="@ViewBag.NamLoc" class="form-control" placeholder="Năm" min="2000" max="2100" style="width: 33%;" title="Năm" />
                    </div>
                </div>

                <!-- Trạng thái -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted small">Trạng thái</label>
                    <select name="trangThai" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.TrangThaiLoc as string))">Tất cả trạng thái</option>
                        <option value="ChuaThanhToan" selected="@(ViewBag.TrangThaiLoc as string == "ChuaThanhToan")">Chưa thanh toán</option>
                        <option value="DaThanhToan" selected="@(ViewBag.TrangThaiLoc as string == "DaThanhToan")">Đã thanh toán</option>
                    </select>
                </div>

                <!-- Nút Lọc & Xóa lọc -->
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark px-3 fw-semibold flex-grow-1">
                        <i class="bi bi-funnel-fill me-1"></i> Lọc
                    </button>
                    <button type="button" id="btnXoaLoc" class="btn btn-outline-secondary px-3" title="Xóa điều kiện lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>

            </div>
        </form>
    </div>

    <!-- Bảng và phân trang được tải bằng AJAX -->
    <div id="danhSachHoaDon">
        @await Html.PartialAsync("_DanhSachHoaDon", Model)
    </div>
    <!-- Modal Chi Tiết Hóa Đơn -->
    <div class="modal fade" id="chiTietHoaDonModal" tabindex="-1" aria-labelledby="chiTietHoaDonModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="modalContentContainer">
                <!-- Nội dung chi tiết hóa đơn sẽ được load vào đây bằng AJAX -->
                <div class="modal-body text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var urlLayDanhSach = '@Url.Action("Index", "HoaDon")';
    </script>
    <script src="~/js/HoaDon/Index.js" asp-append-version="true"></script>
}