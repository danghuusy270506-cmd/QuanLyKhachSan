@model QuanLyKhachSan.Models.Entities.HoaDon

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}

<div class="container mt-4">
    <h2 class="mb-4">Chi tiết hóa đơn</h2>
    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["ThongBaoThanhCong"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">Thông tin hóa đơn</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <tbody>
                        <tr>
                            <th class="table-light" style="width: 35%;">Mã hóa đơn</th>
                            <td>@Model.MaHoaDon</td>
                        </tr>
                        <tr>
                            <th class="table-light">Mã phiếu đặt phòng</th>
                            <td>@Model.MaPhieu</td>
                        </tr>

                        <tr>
                            <th class="table-light">Tiền phòng</th>
                            <td>@(((int)ViewBag.TienPhong).ToString("N0")) VNĐ
                            </td>
                        </tr>
                        <tr>
                            <th class="table-light">Tiền dịch vụ</th>
                            <td>@(((int)ViewBag.TienDichVu).ToString("N0")) VNĐ
                            </td>
                        </tr>

                        <tr>
                            <th class="table-light">Tiền cọc</th>
                            <td>@Model.TienCoc.ToString("N0") VNĐ
                            </td>
                        </tr>

                        <tr>
                            <th class="table-light">Giảm giá</th>
                            <td>@Model.GiamGia.ToString("N0") VNĐ
                            </td>
                        </tr>

                        <tr>
                            <th class="table-light">Tổng tiền thanh toán</th>
                            <td>
                                <strong>@Model.TongTien.ToString("N0") VNĐ</strong>
                            </td>
                        </tr>

                        <tr>
                            <th class="table-light">Kiểu thanh toán</th>
                            <td>
                                @(string.IsNullOrEmpty(Model.KieuThanhToan) ? "Chưa xác định" : Model.KieuThanhToan)
                            </td>
                        </tr>

                        <tr>
                            <th class="table-light">Thời gian thanh toán</th>
                            <td>
                                @if (Model.ThoiGianThanhToan == DateTime.MinValue)
                                {
                                    <span class="text-muted">Chưa thanh toán</span>
                                }
                                else
                                {
                                    @Model.ThoiGianThanhToan.ToString("dd/MM/yyyy HH:mm")
                                }
                            </td>
                        </tr>

                        <tr>
                            <th class="table-light">Trạng thái thanh toán</th>
                            <td>
                                @if (Model.TrangThai == "DaThanhToan")
                                {
                                    <span class="badge bg-success">Đã thanh toán</span>
                                }
                                else if (Model.TrangThai == "DaHoanTien")
                                {
                                    <span class="badge bg-warning text-dark">Đã hoàn tiền</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Chưa thanh toán</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.KieuThanhToan == "Chuyển khoản"
    && Model.TrangThai == "ChuaThanhToan"
    && !string.IsNullOrEmpty(ViewBag.VietQrUrl as string))
        {
            <div class="mt-4 p-4 border rounded-3 bg-light">

                <h5 class="fw-bold text-primary mb-3">
                    <i class="bi bi-qr-code-scan me-2"></i>
                    Thanh toán bằng chuyển khoản
                </h5>

                <div class="row align-items-center g-4">

                    <div class="col-md-5 text-center">
                        <img src="@ViewBag.VietQrUrl"
                             alt="QR chuyển khoản"
                             class="img-fluid bg-white rounded-3 shadow-sm p-2"
                             style="max-width: 260px;" />
                    </div>

                    <div class="col-md-7">

                        <p>
                            <strong>Ngân hàng:</strong>
                            @ViewBag.NganHang
                        </p>

                        <p>
                            <strong>Số tài khoản:</strong>
                            @ViewBag.SoTaiKhoan
                        </p>

                        <p>
                            <strong>Chủ tài khoản:</strong>
                            @ViewBag.TenChuTaiKhoan
                        </p>

                        <p>
                            <strong>Số tiền:</strong>
                            <span class="text-danger fw-bold">
                                @Model.TongTien.ToString("N0") VNĐ
                            </span>
                        </p>

                        <p>
                            <strong>Nội dung:</strong>
                            <span class="text-primary fw-bold">
                                @ViewBag.NoiDungChuyenKhoan
                            </span>
                        </p>

                        <div class="alert alert-info small mb-0">
                            Quý khách vui lòng kiểm tra đúng người nhận,
                            số tiền và nội dung trước khi chuyển khoản.
                        </div>

                    </div>
                </div>
            </div>
        }
        <div class="card-footer d-flex flex-wrap gap-2">
            <a asp-controller="HoaDon" asp-action="Index" class="btn btn-secondary">Quay lại</a>

            @if (Model.TrangThai == "ChuaThanhToan")
            {
                <form asp-controller="HoaDon" asp-action="XacNhanThanhToan" method="post" onsubmit="return confirm('Bạn đã xác minh khách thanh toán đủ tiền chưa?');">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="maHoaDon" value="@Model.MaHoaDon" />
                    <button type="submit" class="btn btn-success">Xác nhận đã nhận tiền</button>
                </form>
            }
            else if (Model.TrangThai == "DaThanhToan")
            {
                <span class="badge bg-success d-inline-flex align-items-center">Đã thanh toán</span>
            }
        </div>
    </div>
</div>