<form asp-controller="DangNhap" asp-action="Authentication" method="post">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger py-2 mb-3">@ViewBag.Error</div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <label class="form-label fw-bold">Tên đăng nhập</label>
        <input type="text" name="username" class="form-control"
               value="@Context.Request.Cookies["SavedUsername"]" required placeholder="Nhập username..." />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Mật khẩu</label>
        <input type="password" name="password" class="form-control" required placeholder="Nhập mật khẩu..." />
    </div>

    <!-- Checkbox Cookies Remember Me -->
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="rememberMe" value="true" id="rememberMeCheck"
        @(string.IsNullOrEmpty(Context.Request.Cookies["SavedUsername"]) ? "" : "checked") />
        <label class="form-check-label" for="rememberMeCheck">
            Ghi nhớ tên đăng nhập
        </label>
    </div>

    <button type="submit" class="btn btn-primary w-100 fw-bold">Đăng Nhập</button>
</form>