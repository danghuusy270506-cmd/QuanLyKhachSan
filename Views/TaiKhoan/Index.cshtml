@model IEnumerable<QuanLyKhachSan.Models.Entities.TaiKhoan>

@{
    ViewData["Title"] = "Quản lý Tài Khoản";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary fw-bold mb-0">
            <i class="bi bi-people-fill me-2"></i>Danh Sách Tài Khoản
        </h3>
        <a asp-action="Create" class="btn btn-success fw-bold">
            <i class="bi bi-plus-circle me-1"></i> Tạo tài khoản mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã TK</th>
                            <th>Tên đăng nhập</th>
                            <th>Quyền (Role)</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Chưa có tài khoản nào trong hệ thống.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">#@item.MaTaiKhoan</td>
                                    <td>
                                        <span class="fw-bold text-dark">@item.Username</span>
                                    </td>
                                    <td>
                                        @if (item.Role == "ADMIN")
                                        {
                                            <span class="badge bg-danger">ADMIN</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">CUSTOMER</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.TrangThai == "HoatDong")
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Bị khóa</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-mataikhoan="@item.MaTaiKhoan" class="btn btn-sm btn-outline-info me-1" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-mataikhoan="@item.MaTaiKhoan" class="btn btn-sm btn-outline-warning me-1" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-mataikhoan="@item.MaTaiKhoan" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>