@model IEnumerable<QuanLyKhachSan.Models.Entities.TaiKhoan>

@{
    ViewData["Title"] = "Danh sách tài khoản";
    int pageNumber = ViewBag.PageNumber ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    string? keyword = ViewBag.Keyword;
    string? role = ViewBag.Role;
    string? trangThai = ViewBag.TrangThai;
    var roleList = ViewBag.RoleList as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var trangThaiList = ViewBag.TrangThaiList as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<h2>Danh sách tài khoản</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="keyword" value="@keyword"
               class="form-control" placeholder="Tìm theo Username..." />
    </div>
    <div class="col-md-3">
        <select name="role" class="form-select">
            <option value="">-- Tất cả vai trò --</option>
            @foreach (var r in roleList ?? new())
            {
                <option value="@r.Value" selected="@(r.Value == role)">@r.Text</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="trangThai" class="form-select">
            <option value="">-- Tất cả trạng thái --</option>
            @foreach (var t in trangThaiList ?? new())
            {
                <option value="@t.Value" selected="@(t.Value == trangThai)">@t.Text</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Tìm / Lọc</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>

<p>Tổng: <strong>@totalCount</strong> tài khoản — Trang @pageNumber / @totalPages</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Username</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center">Không có dữ liệu.</td></tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaTaiKhoan</td>
                    <td>@item.Username</td>
                    <td>@item.Role</td>
                    <td>@item.TrangThai</td>
                    <td>
                        <a asp-action="Edit" asp-route-mataikhoan="@item.MaTaiKhoan" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Details" asp-route-mataikhoan="@item.MaTaiKhoan" class="btn btn-sm btn-info">Chi tiết</a>
                        <a asp-action="Delete" asp-route-mataikhoan="@item.MaTaiKhoan" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@* Phân trang *@
<nav>
    <ul class="pagination">
        <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-keyword="@keyword"
               asp-route-role="@role"
               asp-route-trangThai="@trangThai"
               asp-route-page="@(pageNumber - 1)">«</a>
        </li>

        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == pageNumber ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-keyword="@keyword"
                   asp-route-role="@role"
                   asp-route-trangThai="@trangThai"
                   asp-route-page="@i">@i</a>
            </li>
        }

        <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-keyword="@keyword"
               asp-route-role="@role"
               asp-route-trangThai="@trangThai"
               asp-route-page="@(pageNumber + 1)">»</a>
        </li>
    </ul>
</nav>