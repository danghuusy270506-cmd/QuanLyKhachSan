@model QuanLyKhachSan.Models.Entities.TaiKhoan

@{
    // Kiểm tra nếu request là AJAX thì không load Layout chung của ứng dụng
    bool isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    Layout = isAjax ? null : "_Layout";
}

@if (!isAjax)
{
    <h1>Chi tiết tài khoản</h1>
    <hr />
}

<div class="p-2">
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Mã Tài Khoản:</dt>
        <dd class="col-sm-8 fw-bold">#@Model.MaTaiKhoan</dd>

        <dt class="col-sm-4 text-muted">Tên đăng nhập:</dt>
        <dd class="col-sm-8 fw-semibold">@Model.Username</dd>

        <dt class="col-sm-4 text-muted">Quyền (Role):</dt>
        <dd class="col-sm-8">
            @if (Model.Role == "ADMIN" || Model.Role == "Admin")
            {
                <span class="badge bg-danger">ADMIN</span>
            }
            else if (Model.Role == "NhanVien")
            {
                <span class="badge bg-warning text-dark">NHÂN VIÊN</span>
            }
            else
            {
                <span class="badge bg-info text-dark">KHÁCH HÀNG</span>
            }
        </dd>

        <dt class="col-sm-4 text-muted">Trạng thái:</dt>
        <dd class="col-sm-8">
            @if (Model.TrangThai == "HoatDong")
            {
                <span class="badge bg-success">Hoạt động</span>
            }
            else
            {
                <span class="badge bg-secondary">Bị khóa</span>
            }
        </dd>
    </dl>
</div>

@if (!isAjax)
{
    <div class="mt-3">
        <a asp-action="Edit" asp-route-mataikhoan="@Model?.MaTaiKhoan" class="btn btn-warning">Chỉnh sửa</a> |
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
}