@model List<QuanLyKhachSan.Models.Entities.TaiKhoan>

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<h2 class="mb-3">Danh sách tài khoản</h2>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Tên đăng nhập</th>
            <th>Mật khẩu</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(model => item.Username)</td>
                    <td>@Html.DisplayFor(model => item.Password)</td> @* Hiển thị mật khẩu mã hóa *@
                    <td>@Html.DisplayFor(model => item.Role)</td>
                    <td>
                        @Html.DisplayFor(model => item.TrangThai)
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan" class="btn btn-sm btn-outline-primary me-1">Sửa</a>
                        <a asp-action="Details" asp-route-id="@item.MaTaiKhoan" class="btn btn-sm btn-outline-info me-1">Chi tiết</a>
                        <a asp-action="Delete" asp-route-id="@item.MaTaiKhoan" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Không có dữ liệu</td>
            </tr>
        }
    </tbody>
</table>

@* Thanh phân trang Bootstrap *@
@if (ViewBag.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination">
            @* Nút Trở về (Previous) *@
            <li class="page-item @(ViewBag.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Indexx" asp-route-page="@(ViewBag.PageNumber - 1)">&laquo;</a>
            </li>

            @* Danh sách các trang *@
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Indexx" asp-route-page="@i">@i</a>
                </li>
            }

            @* Nút Tiếp theo (Next) *@
            <li class="page-item @(ViewBag.PageNumber == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Indexx" asp-route-page="@(ViewBag.PageNumber + 1)">&raquo;</a>
            </li>
        </ul>
    </nav>
}