@model IEnumerable<QuanLyKhachSan.Models.Entities.TaiKhoan>

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã TK</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Thông Tin</th>
                        <th>Quyền (Role)</th>
                        <th>Trạng Thái</th>
                        <th class="text-center" style="width: 280px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có tài khoản nào trong hệ thống.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">#@item.MaTaiKhoan</td>
                                <td>
                                    <span class="badge-loai-phong">@item.Username</span>
                                </td>
                                <td>
                                    <span class="badge-loai-phong">@item.Username</span>
                                </td>
                                <td>
                                    @if (item.Role == "ADMIN" || item.Role == "Admin")
                                    {
                                        <span class="custom-badge-status" style="background-color: #dc2626; color: #fff;">ADMIN</span>
                                    }
                                    else if (item.Role == "NhanVien")
                                    {
                                        <span class="custom-badge-status" style="background-color: #f59e0b; color: #fff;">NHÂN VIÊN</span>
                                    }
                                    else
                                    {
                                        <span class="custom-badge-status" style="background-color: #0ea5e9; color: #fff;">KHÁCH HÀNG</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TrangThai == "HoatDong")
                                    {
                                        <span class="custom-badge-status status-active">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="custom-badge-status status-locked">Bị khóa</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <a href="javascript:void(0);" class="btn-action btn-action-view btn-view-detail" data-id="@item.MaTaiKhoan" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                        <a href="javascript:void(0);" class="btn-action btn-action-edit btn-edit-modal" data-id="@item.MaTaiKhoan" title="Sửa">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        <a href="javascript:void(0);" class="btn-action btn-action-delete btn-delete-modal" data-id="@item.MaTaiKhoan" title="Xóa">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Phân trang căn giữa -->
@if (ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-content-center mt-4">
        <nav>
            <ul class="pagination custom-pagination mb-0">
                <li class="page-item @(ViewBag.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link ajax-link" href="javascript:void(0);" data-page="@(ViewBag.PageNumber - 1)">Trước</a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.PageNumber ? "active" : "")">
                        <a class="page-link ajax-link" href="javascript:void(0);" data-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.PageNumber == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link ajax-link" href="javascript:void(0);" data-page="@(ViewBag.PageNumber + 1)">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
}