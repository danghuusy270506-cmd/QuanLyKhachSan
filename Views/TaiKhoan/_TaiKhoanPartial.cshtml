@model IEnumerable<QuanLyKhachSan.Models.Entities.TaiKhoan>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="ps-3 py-3">Mã TK</th>
                        <th>Tên đăng nhập</th>
                        <th>Số điện thoại / Thông tin</th>
                        <th>Quyền (Role)</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có tài khoản nào trong hệ thống.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-secondary">#@item.MaTaiKhoan</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">@item.Username</span>
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-75 text-white">@item.Username</span>
                                </td>
                                <td>
                                    @if (item.Role == "ADMIN" || item.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">ADMIN</span>
                                    }
                                    else if (item.Role == "NhanVien")
                                    {
                                        <span class="badge bg-warning text-dark">NHÂN VIÊN</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">KHÁCH HÀNG</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TrangThai == "HoatDong")
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Bị khóa</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button type="button"
                                            class="btn btn-outline-info btn-sm btn-view-detail d-inline-flex align-items-center gap-1 px-2 py-1"
                                            data-id="@item.MaTaiKhoan"
                                            style="border-color: #0dcaf0; color: #0dcaf0;">
                                        <i class="bi bi-eye fs-6"></i>
                                        <span>Chi tiết</span>
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-warning me-1 btn-edit-modal"
                                            data-id="@item.MaTaiKhoan"
                                            title="Sửa">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger btn-delete-modal"
                                            data-id="@item.MaTaiKhoan"
                                            title="Xóa">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Thanh phân trang *@
@if (ViewBag.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination">
            <li class="page-item @(ViewBag.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link ajax-link" href="javascript:void(0);" data-page="@(ViewBag.PageNumber - 1)">Trước</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.PageNumber ? "active" : "")">
                    <a class="page-link ajax-link" href="javascript:void(0);" data-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.PageNumber == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link ajax-link" href="javascript:void(0);" data-page="@(ViewBag.PageNumber + 1)">Sau</a>
            </li>
        </ul>
    </nav>
}